---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { apps } from "../config/apps";
import { saas } from "../config/saas";
import { getLangFromLocals } from "../i18n/utils";

export const prerender = false;

const lang = getLangFromLocals(Astro.locals);

const allProducts = [...saas, ...apps].filter(
  (product, index, list) => list.findIndex(p => p.id === product.id) === index
);

const archived = allProducts
  .filter(product => product.archive)
  .map(product => ({
    id: product.id,
    name: product.name,
    description: product.description[lang],
    icon: product.icon,
    link: product.link,
  }));

const copy = {
  es: {
    label: "Archivo",
    title: "Proyectos archivados",
    subtitle:
      "Estos proyectos ya no reciben mantenimiento activo, pero siguen disponibles por si te sirven.",
    back: "Volver al inicio",
    visit: "Visitar",
    count: (n: number) => `${n} proyectos en el archivo`,
  },
  en: {
    label: "Archive",
    title: "Archived projects",
    subtitle:
      "These projects are no longer actively maintained, but they are still available in case they are useful to you.",
    back: "Back to home",
    visit: "Visit",
    count: (n: number) => `${n} projects in the archive`,
  },
}[lang];
---

<Layout title={`${copy.title} | Inled Group`} description={copy.subtitle}>
  <Header />

  <main class="archive-page">
    <div class="archive-inner">
      <a href="/" class="archive-back">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        {copy.back}
      </a>

      <header class="archive-head">
        <span class="archive-label">{copy.label}</span>
        <h1 class="archive-title">{copy.title}</h1>
        <p class="archive-subtitle">{copy.subtitle}</p>
        <p class="archive-count">{copy.count(archived.length)}</p>
      </header>

      <div class="archive-grid">
        {archived.map((product) => (
          <a
            href={product.link}
            class="archive-item"
            target={product.link.startsWith("http") ? "_blank" : undefined}
            rel={product.link.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            <img src={product.icon} alt="" width="36" height="36" loading="lazy" />
            <span class="archive-main">
              <span class="archive-name">{product.name}</span>
              <span class="archive-desc">{product.description}</span>
            </span>
            <span class="archive-cta">
              {copy.visit}
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  .archive-page {
    width: 100%;
    background: var(--bg);
    min-height: 100svh;
    padding-top: 52px;
  }

  .archive-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  .archive-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--sans-font);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 3rem;
    transition: color 0.2s ease;
  }

  .archive-back:hover {
    color: var(--text);
  }

  .archive-head {
    max-width: 640px;
    margin-bottom: 3rem;
  }

  .archive-label {
    display: block;
    font-family: var(--sans-font);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.9rem;
  }

  .archive-title {
    font-family: var(--sans-font);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--text);
    margin: 0 0 0.9rem;
  }

  .archive-subtitle {
    font-family: var(--sans-font);
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    line-height: 1.55;
    color: var(--text-dim);
    margin: 0;
  }

  .archive-count {
    font-family: var(--sans-font);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 1rem 0 0;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 22px;
    overflow: hidden;
  }

  .archive-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    background: var(--bg);
    color: var(--text);
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .archive-item:hover {
    background: var(--surface);
  }

  .archive-item img {
    width: 36px;
    height: 36px;
    object-fit: contain;
    opacity: 0.85;
  }

  .archive-main {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .archive-name {
    font-family: var(--sans-font);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .archive-desc {
    font-family: var(--sans-font);
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .archive-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--sans-font);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .archive-item:hover .archive-cta {
    color: var(--text);
  }

  @media (max-width: 968px) {
    .archive-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .archive-inner {
      padding: 2.5rem 1rem 4rem;
    }

    .archive-grid {
      grid-template-columns: 1fr;
      border-radius: 18px;
    }

    .archive-item {
      padding: 1.35rem;
    }
  }
</style>
