---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { getLangFromLocals } from '../i18n/utils';

export const prerender = false;

const lang = getLangFromLocals(Astro.locals);

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');

const copy = {
  es: {
    label: 'Documento interno',
    title: 'Estrategia de marca',
    intro:
      'Esta página recoge hacia dónde queremos llevar Inled en los próximos años: qué proyectos forman parte del ecosistema, cómo los presentamos y qué principios no estamos dispuestos a romper.',
    sections: [
      {
        title: 'Un ecosistema, no una colección de apps',
        paragraphs: [
          'Pulsar OS es el centro del ecosistema. InSuite, Seafari, iccount y el resto de herramientas existen para que el sistema operativo sea más útil, más privado y más fácil de adoptar.',
          'Cada producto debe poder entenderse por separado, pero todos comparten la misma promesa: software libre, privado y gratuito, sin anuncios ni condiciones ocultas.',
        ],
      },
      {
        title: 'Lo que no vamos a romper',
        paragraphs: [
          'La privacidad del usuario no se negocia. El software que construimos funciona en local siempre que sea posible y no convierte los datos personales en un producto.',
          'Tampoco vamos a esconder el modelo de sostenibilidad: las donaciones y los contratos existen para que el proyecto pueda seguir siendo libre, y lo contamos con claridad.',
        ],
      },
      {
        title: 'Comunidad y colaboración',
        paragraphs: [
          'La comunidad no es una audiencia: es parte del equipo. Discord, Telegram, GitHub y las colaboraciones puntuales son la forma en la que Pulsar OS avanza.',
          'Si quieres aportar tiempo, hardware o conocimiento, la puerta está abierta. La colaboración no es remunerada, pero siempre damos crédito en las publicaciones oficiales.',
        ],
      },
      {
        title: 'Donaciones y sostenibilidad',
        paragraphs: [
          'Las donaciones monetarias y los contratos están planificados para febrero de 2027, cuando la estructura legal esté lista. Hasta entonces, la mejor forma de ayudar es colaborar o cedernos hardware para probar Pulsar OS.',
          'Cuando llegue el momento, el dinero se destinará a infraestructura, hardware de pruebas y tiempo de desarrollo. No habrá anuncios ni venta de datos para financiar el proyecto.',
        ],
      },
    ],
    note: 'Documento vivo. Esta página no está indexada en buscadores y puede cambiar sin aviso.',
    back: 'Volver a Inled',
    donate: 'Cómo ayudar ahora',
  },
  en: {
    label: 'Internal document',
    title: 'Brand strategy',
    intro:
      'This page explains where we want to take Inled in the coming years: which projects belong to the ecosystem, how we present them and which principles we are not willing to break.',
    sections: [
      {
        title: 'One ecosystem, not a collection of apps',
        paragraphs: [
          'Pulsar OS is the centre of the ecosystem. InSuite, Seafari, iccount and the rest of the tools exist to make the operating system more useful, more private and easier to adopt.',
          'Every product should stand on its own, but they all share the same promise: free, private software with no ads and no hidden conditions.',
        ],
      },
      {
        title: 'What we will not break',
        paragraphs: [
          'User privacy is not negotiable. The software we build runs locally whenever possible and does not turn personal data into a product.',
          'We will not hide the sustainability model either: donations and contracts exist so the project can stay free, and we explain that clearly.',
        ],
      },
      {
        title: 'Community and collaboration',
        paragraphs: [
          'The community is not an audience: it is part of the team. Discord, Telegram, GitHub and one-off collaborations are how Pulsar OS moves forward.',
          'If you want to contribute time, hardware or knowledge, the door is open. Collaboration is unpaid, but we always give credit in official publications.',
        ],
      },
      {
        title: 'Donations and sustainability',
        paragraphs: [
          'Monetary donations and contracts are planned for February 2027, once the legal structure is ready. Until then, the best way to help is to collaborate or lend us hardware to test Pulsar OS.',
          'When the time comes, the money will go to infrastructure, testing hardware and development time. There will be no ads and no data selling to fund the project.',
        ],
      },
    ],
    note: 'Living document. This page is not indexed by search engines and may change without notice.',
    back: 'Back to Inled',
    donate: 'How to help now',
  },
}[lang];

const homeHref = lang === 'es' ? '/es/' : '/';
const donateHref = 'https://donate.inled.es';
---

<Layout
  title={lang === 'es' ? 'Estrategia de marca — Inled Group' : 'Brand strategy — Inled Group'}
  description={copy.intro}
  noindex
>
  <Header />

  <main class="strategy-page">
    <!--  <article class="strategy-inner">
      <a class="strategy-back" href={homeHref}>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        {copy.back}
      </a>

      <p class="strategy-label">{copy.label}</p>
      <h1 class="strategy-title">{copy.title}</h1>
      <p class="strategy-intro">{copy.intro}</p>

      <div class="strategy-sections">
        {copy.sections.map((section) => (
          <section class="strategy-section">
            <h2 class="strategy-subtitle">{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p class="strategy-text">{paragraph}</p>)}
          </section>
        ))}
      </div>

      <p class="strategy-note">{copy.note}</p>

      <a class="strategy-cta" href={donateHref}>
        {copy.donate}
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </article>-->
  </main>
</Layout>

<style>
  .strategy-page {
    min-height: 100vh;
    background: var(--bg);
    padding: 8rem 1.5rem 7rem;
  }

  .strategy-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .strategy-back {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-bottom: 3rem;
    font-family: var(--sans-font);
    font-size: 0.85rem;
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .strategy-back:hover {
    color: var(--accent);
  }

  .strategy-label {
    font-family: var(--sans-font);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }

  .strategy-title {
    font-family: var(--sans-font);
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
    color: var(--text);
    margin: 0 0 1.25rem;
  }

  .strategy-intro {
    font-family: var(--sans-font);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.55;
    color: var(--text-dim);
    margin: 0 0 3rem;
    max-width: 62ch;
    text-wrap: pretty;
  }

  .strategy-sections {
    border-top: 1px solid var(--border);
  }

  .strategy-section {
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
  }

  .strategy-subtitle {
    font-family: var(--sans-font);
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--text);
    margin: 0 0 0.9rem;
  }

  .strategy-text {
    font-family: var(--sans-font);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-dim);
    margin: 0 0 1rem;
    max-width: 68ch;
    text-wrap: pretty;
  }

  .strategy-text:last-child {
    margin-bottom: 0;
  }

  .strategy-note {
    margin: 2rem 0 0;
    font-family: var(--sans-font);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .strategy-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    margin-top: 2rem;
    padding: 0 1.4rem;
    border-radius: 980px;
    background: var(--accent);
    color: #fff;
    font-family: var(--sans-font);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .strategy-cta:hover {
    background: var(--accent-hover);
  }

  .strategy-cta:active {
    transform: scale(0.975);
  }

  @media (max-width: 640px) {
    .strategy-page {
      padding: 7rem 1rem 5rem;
    }
  }
</style>
