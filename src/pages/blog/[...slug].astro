---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getPosts, formatDate } from '../../lib/blogger';
import type { BlogPost } from '../../lib/blogger';
import { getLangFromLocals, useTranslatedPath } from '../../i18n/utils';
export const prerender = false;

const { slug } = Astro.params;
const posts = await getPosts();
const post = posts.find((p) => p.slug === slug);

if (!post) {
  return Astro.redirect("/404");
}

const lang = getLangFromLocals(Astro.locals);
const localize = useTranslatedPath(lang);

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://inled.es" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://inled.es/blog" },
    { "@type": "ListItem", "position": 3, "name": post.title, "item": `https://inled.es/blog/${post.slug}` }
  ]
};
---

<Layout title={`${post.title} | Inled Blog`} description={post.title}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <article class="post-page">
    <header class="post-header">
      <div class="post-header-inner">
        <a href={localize('/blog')} class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
          <span>Blog</span>
        </a>

        <div class="post-meta">
          <span class="post-date">{formatDate(post.published)}</span>
          {post.author && (
            <>
              <span class="meta-dot"></span>
              <span class="post-author">{post.author}</span>
            </>
          )}
        </div>

        <h1 class="post-title">{post.title}</h1>

        {post.tags.length > 0 && (
          <div class="post-tags">
            {post.tags.map(tag => (
              <span class="post-tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="post-body">
      <div class="post-body-inner">
        <div class="post-content" set:html={post.content} />
      </div>
    </div>
  </article>
</Layout>

<style>
  .post-page {
    min-height: 100vh;
    background: var(--bg);
  }

  .post-header {
    padding: 8rem 1.5rem 3rem;
    border-bottom: 1px solid var(--border);
  }

  .post-header-inner {
    max-width: 750px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--sans-font);
    font-size: 0.875rem;
    color: var(--text-dim);
    text-decoration: none;
    margin-bottom: 2.5rem;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .post-date {
    font-family: var(--sans-font);
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .meta-dot {
    width: 3px;
    height: 3px;
    background: var(--text-muted);
    border-radius: 50%;
  }

  .post-author {
    font-family: var(--sans-font);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .post-title {
    font-family: var(--sans-font);
    font-size: clamp(2rem, 5vw, 3.1rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.04em;
    line-height: 1.08;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }

  .post-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .post-tag {
    font-family: var(--sans-font);
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 500;
  }

  .post-body {
    padding: 3rem 1.5rem 6rem;
  }

  .post-body-inner {
    max-width: 750px;
    margin: 0 auto;
  }

  .post-content {
    font-family: var(--sans-font);
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.8;
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .post-content :global(h2) {
    font-family: var(--sans-font);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--text);
    margin: 3rem 0 1rem;
    letter-spacing: -0.02em;
  }

  .post-content :global(h3) {
    font-family: var(--sans-font);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text);
    margin: 2.5rem 0 0.75rem;
  }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: rgba(0, 113, 227, 0.35);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }

  .post-content :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 2rem 0;
  }

  .post-content :global(ul), .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.25rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(blockquote) {
    border-left: 2px solid var(--border-hover);
    padding: 0.75rem 0 0.75rem 1.25rem;
    margin: 2rem 0;
    color: var(--text-dim);
    font-style: italic;
  }

  .post-content :global(code) {
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 0.85em;
    background: var(--surface-grouped);
    padding: 0.15rem 0.4rem;
    border-radius: 5px;
  }

  .post-content :global(pre) {
    background: var(--surface-grouped);
    border-radius: 12px;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 2rem 0;
  }

  .post-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  @media (max-width: 640px) {
    .post-header { padding: 7rem 1rem 2rem; }
    .post-body { padding: 2rem 1rem 4rem; }
  }
</style>
