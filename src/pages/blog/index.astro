---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getPosts, formatDate } from '../../lib/blogger';
export const prerender = false;
import { getLangFromLocals } from '../../i18n/utils';

const lang = getLangFromLocals(Astro.locals);
const posts = await getPosts();
---

<Layout title="Blog | Inled Group" description="Últimas noticias y actualizaciones de Inled Group">
  <Header />

  <main class="blog-page">
    <section class="blog-hero">
      <div class="blog-hero-inner">
        <p class="blog-hero-label">BLOG</p>
        <h1 class="blog-hero-title">{lang === 'es' ? 'Novedades' : 'Updates'}</h1>
        <p class="blog-hero-sub">{lang === 'es' ? 'Noticias y actualizaciones de Inled Group' : 'News and updates from Inled Group'}</p>
      </div>
    </section>

    <section class="blog-entries">
      <div class="blog-entries-inner">
        <div class="blog-entries-list">
          {posts.map((post, i) => (
            <a href={`/blog/${post.slug}`} class="entry-row" data-thumb={post.thumbnail || ''} style={`animation-delay: ${i * 30}ms`}>
              <div class="entry-bg" style={`background-image: url(${post.thumbnail || ''})`}></div>
              <div class="entry-content">
                <div class="entry-meta">
                  <span class="entry-index">{String(i + 1).padStart(2, '0')}</span>
                  <span class="entry-date">{formatDate(post.published)}</span>
                </div>
                <h2 class="entry-title">{post.title}</h2>
              </div>
              {post.tags.length > 0 && (
                <span class="entry-tag">{post.tags[0]}</span>
              )}
              <svg class="entry-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .blog-page {
    min-height: 100vh;
    background: var(--bg);
  }

  .blog-hero {
    padding: 8rem 5% 4rem;
    border-bottom: 1px solid var(--border);
  }

  .blog-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .blog-hero-label {
    font-family: var(--pixel-font);
    font-size: 0.5rem;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .blog-hero-title {
    font-family: var(--sans-font);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 0.5rem;
  }

  .blog-hero-sub {
    font-family: var(--mono-font);
    font-size: 0.9rem;
    color: var(--accent-dim);
  }

  .blog-entries {
    padding: 0 5% 6rem;
  }

  .blog-entries-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .blog-entries-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    margin-top: 3rem;
  }

  .entry-row {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0;
    background: var(--bg);
    border-bottom: none;
    text-decoration: none;
    color: var(--accent-dim);
    overflow: hidden;
    animation: entryIn 0.4s ease-out both;
    min-height: 160px;
  }

  .entry-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
  }

  .entry-row:hover .entry-bg {
    opacity: 0.15;
  }

  .entry-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    background: var(--bg);
    transition: background 0.3s ease;
  }

  .entry-row:hover .entry-content {
    background: transparent;
  }

  .entry-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  @keyframes entryIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .entry-row:hover {
    color: #fff;
  }

  .entry-row .entry-index {
    font-family: var(--pixel-font);
    font-size: 0.5rem;
    color: rgba(255, 255, 255, 0.2);
  }

  .entry-date {
    font-family: var(--mono-font);
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .entry-title {
    font-family: var(--sans-font);
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    margin: 0;
    line-height: 1.3;
  }

  .entry-tag {
    position: relative;
    z-index: 1;
    font-family: var(--mono-font);
    font-size: 0.5rem;
    color: rgba(255, 255, 255, 0.25);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border: 1px solid var(--border);
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    font-weight: 700;
    margin: 0 1.5rem 1rem;
    align-self: flex-start;
  }

  .entry-arrow {
    position: absolute;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 1;
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: all 0.2s;
  }

  .entry-row:hover .entry-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (max-width: 640px) {
    .blog-entries-list {
      grid-template-columns: 1fr;
    }
    .entry-tag { display: none; }
    .blog-hero { padding: 7rem 5% 3rem; }
    .blog-entries { padding: 0 5% 4rem; }
  }
</style>
