---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getPosts, formatDate } from '../../lib/blogger';
export const prerender = false;
import { getLangFromLocals, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromLocals(Astro.locals);
const localize = useTranslatedPath(lang);
const posts = await getPosts();

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://inled.es/blog#blog",
  "name": "Inled Blog",
  "url": "https://inled.es/blog",
  "publisher": { "@id": "https://inled.es/#organization" },
  "blogPost": posts.slice(0, 10).map(p => ({
    "@type": "BlogPosting",
    "headline": p.title,
    "datePublished": p.published,
    "url": `https://inled.es/blog/${p.slug}`,
  })),
};
---

<Layout title="Blog | Inled Group" description="Latest news and updates from Inled Group — releases, announcements and behind-the-scenes of our open source projects">
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(blogJsonLd)} />

  <main class="blog-page">
    <section class="blog-hero">
      <div class="blog-hero-inner">
        <p class="blog-hero-label">BLOG</p>
        <h1 class="blog-hero-title">{lang === 'es' ? 'Novedades' : 'Updates'}</h1>
        <p class="blog-hero-sub">
          {lang === 'es'
            ? 'Noticias y actualizaciones de Inled Group.'
            : 'News and updates from Inled Group.'}
        </p>
      </div>
    </section>

    <section class="blog-entries">
      <div class="blog-entries-inner">
        {posts.length > 0 ? posts.map((post) => (
          <a href={localize(`/blog/${post.slug}`)} class="entry-row">
            <span class="entry-main">
              <span class="entry-meta">
                <time class="entry-date" datetime={post.published}>{formatDate(post.published)}</time>
                {post.tags.length > 0 && <span class="entry-tag">{post.tags[0]}</span>}
              </span>
              <h2 class="entry-title">{post.title}</h2>
            </span>

            {post.thumbnail && (
              <img class="entry-thumb" src={post.thumbnail} alt="" loading="lazy" />
            )}

            <svg class="entry-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        )) : (
          <p class="blog-empty">
            {lang === 'es' ? 'Pronto habrá nuevas entradas.' : 'New posts coming soon.'}
          </p>
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
  .blog-page {
    min-height: 100vh;
    background: var(--bg);
  }

  .blog-hero {
    padding: 8rem 1.5rem 3.5rem;
    border-bottom: 1px solid var(--border);
  }

  .blog-hero-inner {
    max-width: 980px;
    margin: 0 auto;
  }

  .blog-hero-label {
    font-family: var(--sans-font);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }

  .blog-hero-title {
    font-family: var(--sans-font);
    font-size: clamp(2.5rem, 7vw, 4.2rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.045em;
    line-height: 1.05;
    margin: 0 0 0.8rem;
  }

  .blog-hero-sub {
    font-family: var(--sans-font);
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--text-dim);
    margin: 0;
  }

  .blog-entries {
    padding: 0 1.5rem 7rem;
  }

  .blog-entries-inner {
    max-width: 980px;
    margin: 0 auto;
    border-top: 1px solid var(--border);
  }

  .entry-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
  }

  .entry-main {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .entry-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .entry-date {
    font-family: var(--sans-font);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .entry-tag {
    font-family: var(--sans-font);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--accent);
  }

  .entry-title {
    font-family: var(--sans-font);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--text);
    margin: 0;
    transition: color 0.18s ease;
  }

  .entry-row:hover .entry-title {
    color: var(--accent);
  }

  .entry-thumb {
    width: 160px;
    height: 90px;
    object-fit: cover;
    border-radius: 10px;
    display: block;
  }

  .entry-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .entry-row:hover .entry-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .entry-row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .blog-empty {
    font-family: var(--sans-font);
    font-size: 0.95rem;
    color: var(--text-muted);
    padding: 2rem 0;
    margin: 0;
  }

  @media (max-width: 640px) {
    .blog-hero {
      padding: 7rem 1rem 2.5rem;
    }

    .blog-entries {
      padding: 0 1rem 4.5rem;
    }

    .entry-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1rem;
      padding: 1.35rem 0;
    }

    .entry-thumb {
      width: 96px;
      height: 58px;
      border-radius: 8px;
    }

    .entry-arrow {
      display: none;
    }
  }
</style>
