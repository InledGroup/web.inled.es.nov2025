---
import { getEntry, render } from 'astro:content';
import LegalLayout from '../layouts/LegalLayout.astro';

/**
 * ES: Las páginas legales se renderizan en el servidor para que las rutas /es/
 *     puedan servirse en español mediante el middleware de idioma.
 * EN: Legal pages are server-rendered so /es/ routes can be served in Spanish
 *     through the language middleware.
 */
export const prerender = false;

const { legalSlug } = Astro.params;
const entry = legalSlug ? await getEntry('legal', legalSlug) : undefined;

if (!entry) {
  return Astro.redirect('/404');
}

const { title, description, updatedAt } = entry.data;
const { Content } = await render(entry);
---

<LegalLayout title={title} description={description} updatedAt={updatedAt}>
  <Content />
</LegalLayout>
