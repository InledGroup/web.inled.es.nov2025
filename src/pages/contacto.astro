---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import GuideLines from '../components/GuideLines.astro';
export const prerender = false;

import { getLangFromLocals, useTranslations } from '../i18n/utils';

const lang = getLangFromLocals(Astro.locals);
const t = useTranslations(lang);
---

<Layout
  title="Contacto - Inled Group"
  description={lang === 'es' ? '¿Alguna duda? Resuélvela con nosotros.' : 'Any questions? Resolve them with us.'}
>
  <Header />
  <GuideLines />

  <main class="contact-page">
    <section class="contact-hero">
      <div class="contact-hero-inner">
        <div class="contact-label">{lang === 'es' ? 'CONTACTO' : 'CONTACT'}</div>
        <h1 class="contact-title">{lang === 'es' ? '¿Hablamos?' : 'Let\'s talk?'}</h1>
        <p class="contact-subtitle">{lang === 'es' ? 'Contacta con nosotros por el medio que prefieras' : 'Reach out through whatever works best for you'}</p>
      </div>
    </section>

    <section class="contact-methods">
      <div class="contact-methods-inner">
        <div class="methods-list">
          <a href="mailto:hi@inled.es" class="method-row">
            <span class="method-index">01</span>
            <div class="method-content">
              <span class="method-name">Email</span>
              <span class="method-detail">hi@inled.es</span>
            </div>
            <svg class="method-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </a>

          <a href="https://link.inled.es/discord" target="_blank" rel="noopener" class="method-row">
            <span class="method-index">02</span>
            <div class="method-content">
              <span class="method-name">Discord</span>
              <span class="method-detail">{lang === 'es' ? 'Únete a nuestro servidor' : 'Join our server'}</span>
            </div>
            <svg class="method-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </a>

          <a href="https://matrix.inled.es" target="_blank" rel="noopener" class="method-row">
            <span class="method-index">03</span>
            <div class="method-content">
              <span class="method-name">Matrix</span>
              <span class="method-detail">{lang === 'es' ? 'Chat descentralizado' : 'Decentralized chat'}</span>
            </div>
            <svg class="method-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="contact-form-section">
      <div class="contact-form-inner">
        <div class="form-header">
          <div class="form-label">{lang === 'es' ? 'FORMULARIO' : 'FORM'}</div>
          <h2 class="form-title">{lang === 'es' ? 'Envíanos un mensaje' : 'Send us a message'}</h2>
          <p class="form-subtitle">{lang === 'es' ? 'Rellena el formulario y te responderemos lo antes posible' : 'Fill in the form and we\'ll get back to you as soon as possible'}</p>
        </div>

        <div class="form-widget-wrapper">
          <div id="mailform"></div>
          <p class="form-note">{lang === 'es' ? ' pon tu email en el campo nombre para poder responderte' : ' put your email in the name field so we can reply'}</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script src="https://mailform.inled.es/widget.js" defer></script>

<style>
  .contact-page {
    min-height: 100vh;
    background: var(--bg);
  }

  .contact-hero {
    padding: 8rem 5% 4rem;
    border-bottom: 1px solid var(--border);
  }

  .contact-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .contact-label {
    font-family: var(--pixel-font);
    font-size: 0.5rem;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .contact-title {
    font-family: var(--sans-font);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 0.5rem 0;
  }

  .contact-subtitle {
    font-family: var(--mono-font);
    font-size: 0.9rem;
    color: var(--accent-dim);
    margin: 0;
  }

  .contact-methods {
    padding: 0 5%;
  }

  .contact-methods-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .methods-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    margin: 3rem 0;
  }

  .method-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--accent-dim);
    transition: all 0.15s;
  }

  .method-row:last-child {
    border-bottom: none;
  }

  .method-row:hover {
    background: var(--surface);
    color: #fff;
  }

  .method-index {
    font-family: var(--pixel-font);
    font-size: 0.5rem;
    color: rgba(255, 255, 255, 0.2);
    min-width: 24px;
  }

  .method-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .method-name {
    font-family: var(--sans-font);
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
  }

  .method-detail {
    font-family: var(--mono-font);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.35);
  }

  .method-arrow {
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: all 0.2s;
  }

  .method-row:hover .method-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .contact-form-section {
    padding: 4rem 5% 8rem;
    border-top: 1px solid var(--border);
  }

  .contact-form-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .form-header {
    margin-bottom: 3rem;
  }

  .form-label {
    font-family: var(--pixel-font);
    font-size: 0.5rem;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .form-title {
    font-family: var(--sans-font);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.03em;
    margin: 0 0 0.3rem 0;
  }

  .form-subtitle {
    font-family: var(--mono-font);
    font-size: 0.85rem;
    color: var(--accent-dim);
    margin: 0;
  }

  .form-widget-wrapper {
    max-width: 650px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2.5rem;
  }

  .form-note {
    font-family: var(--mono-font);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.25);
    margin: 1.5rem 0 0 0;
    text-align: center;
  }

  :global(#mailform) {
    color: white;
    font-family: var(--mono-font);
  }

  :global(#mailform .mailform-group) {
    margin-bottom: 1.5rem !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.4rem !important;
  }

  :global(#mailform .mailform-label) {
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 0.6rem !important;
    font-weight: 700 !important;
    color: rgba(255, 255, 255, 0.35) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.12em !important;
    font-family: var(--mono-font) !important;
  }

  :global(#mailform .mailform-input),
  :global(#mailform .mailform-textarea) {
    width: 100% !important;
    margin: 0 !important;
    padding: 0.85rem 1rem !important;
    background: rgba(255, 255, 255, 0.03) !important;
    border: 1px solid var(--border) !important;
    border-radius: 4px !important;
    color: white !important;
    font-size: 0.85rem !important;
    font-family: var(--mono-font) !important;
    transition: all 0.15s !important;
    box-sizing: border-box !important;
    outline: none !important;
  }

  :global(#mailform .mailform-input:focus),
  :global(#mailform .mailform-textarea:focus) {
    background: var(--surface) !important;
    border-color: var(--border-hover) !important;
  }

  :global(#mailform .cf-turnstile) {
    display: flex !important;
    justify-content: center !important;
    margin: 1rem 0 !important;
    width: 100% !important;
  }

  :global(#mailform .mailform-button) {
    width: 100% !important;
    background: #fff !important;
    border: none !important;
    border-radius: 4px !important;
    color: #000 !important;
    padding: 0.85rem !important;
    font-size: 0.7rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    cursor: pointer !important;
    transition: all 0.15s !important;
    font-family: var(--mono-font) !important;
  }

  :global(#mailform .mailform-button:hover) {
    background: rgba(255, 255, 255, 0.85) !important;
  }

  :global(.mailform-success),
  :global(.mailform-error) {
    padding: 1rem;
    border-radius: 4px;
    margin-top: 1.5rem;
    text-align: center;
    font-family: var(--mono-font);
    font-size: 0.8rem;
  }

  :global(.mailform-success) {
    background: rgba(255, 255, 255, 0.03);
    color: #fff;
    border: 1px solid var(--border);
  }

  :global(.mailform-error) {
    background: rgba(239, 68, 68, 0.05);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }

  @media (max-width: 640px) {
    .contact-hero { padding: 7rem 5% 3rem; }
    .form-widget-wrapper { padding: 1.5rem; }
  }
</style>
