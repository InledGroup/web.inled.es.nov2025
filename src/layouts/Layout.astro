---
import Footer from '../components/Footer.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import { getLangFromLocals } from '../i18n/utils';
import { getFeaturedItems } from '../config/featured';
import { apps } from '../config/apps';
import { saas } from '../config/saas';

const lang = getLangFromLocals(Astro.locals);

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "Inled Group — Free, open and privacy-respecting software. Dream, Build.", image = "https://hosted.inled.es/hero-bg.jpg" } = Astro.props;

const SITE = 'https://inled.es';
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE);
const featuredItems = getFeaturedItems().filter(item => !item.archive);

const currentPath = Astro.url.pathname;
const allProducts = [...saas, ...apps];
const isArchivedPage = allProducts.some(p => p.archive && (
  currentPath === p.link || 
  currentPath === p.link + '/' ||
  p.link === currentPath ||
  (p.id && currentPath.includes('/apps/' + p.id))
));

// Orden priorizado para Google Sitelinks: Pulsar OS, Inled Office, Seafari y CodexBar primero
const PRIORITY_NAV = ['Pulsar OS', 'Insuite Office', 'Seafari', 'CodexBar for GNOME'];

const toNavItem = (p: { name: string; link: string; archive?: boolean }) => ({
  name: p.name,
  url: p.link.startsWith('http') ? p.link : `https://inled.es${p.link}`,
});

const prioritizedNav = PRIORITY_NAV
  .map(name => allProducts.find(p => p.name === name && !p.archive))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .map(toNavItem);

const siteNavigation = [
  ...prioritizedNav,
  ...featuredItems.map(toNavItem).filter(n => !prioritizedNav.some(p => p.name === n.name)),
  { name: 'Contact', url: 'https://inled.es/contacto' },
].slice(0, 8);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://inled.es/#organization",
      "name": "Inled Group",
      "url": "https://inled.es",
      "logo": {
        "@type": "ImageObject",
        "url": "https://hosted.inled.es/INLED_simple-removebg-preview.png"
      },
      "sameAs": [
        "https://github.com/InledGroup",
        "https://www.youtube.com/@inledgroup"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://inled.es/#website",
      "url": "https://inled.es",
      "name": "Inled Group",
      "publisher": { "@id": "https://inled.es/#organization" }
    },
    {
      "@type": "ItemList",
      "name": "Active Products",
      "itemListElement": siteNavigation.map((item, index) => ({
      	"@type": "ListItem",
      	"position": index + 1,
      	"name": item.name,
      	"url": item.url
      }))
    }
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <link rel="icon" href="https://hosted.inled.es/cropped-INLED_simple-removebg-preview.png" type="image/x-icon">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Tema: aplicar antes del primer pintado para evitar flash -->
    <script is:inline>
      (function () {
        var theme = 'dark';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          }
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={new URL(Astro.url.pathname, SITE)} />
    <link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname, SITE)} />
    <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname, SITE)} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Inled Group" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src={import.meta.env.BASE_URL + "/upload/https://kit.fontawesome.com/4bf0ac964c.js"} crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="sitemap" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f4f6" />

    <script is:inline type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "rkxkde17af");
        </script>

  </head>
  <body class={isArchivedPage ? "archive-active-body" : ""}>
    {isArchivedPage && (
      <div class="archive-overlay-banner">
        <div class="archive-overlay-content">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.25rem;"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
          <span>
            {lang === 'es' 
              ? 'Este proyecto está archivado y no se mantiene activamente por ahora.' 
              : 'This project is archived and is not actively maintained for now.'}
          </span>
        </div>
      </div>
    )}
    <slot />
    <Footer />
    <script>
      import Lenis from 'lenis';

      // Inicializar Lenis smooth scroll
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 2,
        infinite: false,
      });

      (window as any).lenis = lenis;

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: var(--sans-font);
    overflow-x: hidden;
    background: #000 url('https://hosted.inled.es/better.inled.png') no-repeat center center fixed;
    background-size: cover;
    color: #fff;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  html {
    scroll-behavior: auto; /* Desactivar para que Lenis tome control */
  }

  html.lenis {
    height: auto;
  }

  .lenis.lenis-smooth {
    scroll-behavior: auto;
  }

  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }

  .lenis.lenis-stopped {
    overflow: hidden;
  }

  .lenis.lenis-scrolling iframe {
    pointer-events: none;
  }

  .archive-overlay-banner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(239, 68, 68, 0.1);
    border-bottom: 1px solid rgba(239, 68, 68, 0.2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #f87171;
    z-index: 10000;
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .archive-overlay-content {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  body.archive-active-body .floating-header-container {
    top: 3.5rem !important;
  }

  :root {
    --pixel-font: 'Press Start 2P', monospace;
    --sans-font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --accent: #fff;
    --accent-dim: rgba(255, 255, 255, 0.6);
    --border: rgba(255, 255, 255, 0.1);
    --border-hover: rgba(255, 255, 255, 0.25);
    --surface: rgba(255, 255, 255, 0.03);
    --surface-hover: rgba(255, 255, 255, 0.06);
    --bg: #000;
    --text: #fff;
    --text-dim: rgba(255, 255, 255, 0.6);
    --text-muted: rgba(255, 255, 255, 0.35);
    --card: rgba(255, 255, 255, 0.02);
    --card-hover: rgba(255, 255, 255, 0.05);
    --fill: #fff;
    --fill-text: #000;
    --fill-dim: rgba(0, 0, 0, 0.5);
    --header-bg: rgba(0, 0, 0, 0.7);
  }

  /* Modo claro */
  html[data-theme="light"] {
    color-scheme: light;
    --accent: #0a0a0a;
    --accent-dim: rgba(0, 0, 0, 0.75);
    --border: rgba(0, 0, 0, 0.14);
    --border-hover: rgba(0, 0, 0, 0.35);
    --surface: rgba(0, 0, 0, 0.04);
    --surface-hover: rgba(0, 0, 0, 0.08);
    --bg: #f4f4f6;
    --text: #0a0a0a;
    --text-dim: rgba(0, 0, 0, 0.75);
    --text-muted: rgba(0, 0, 0, 0.55);
    --card: rgba(0, 0, 0, 0.02);
    --card-hover: rgba(0, 0, 0, 0.06);
    --fill: #0a0a0a;
    --fill-text: #fff;
    --fill-dim: rgba(255, 255, 255, 0.65);
    --header-bg: rgba(255, 255, 255, 0.78);
  }

  html[data-theme="light"] body {
    background: #f4f4f6;
    color: #0a0a0a;
  }

  .pixel-text {
    font-family: var(--pixel-font);
  }

  /* ---- Modo claro: ajustes por componente ---- */
  html[data-theme="light"] .site-header {
    background: var(--header-bg);
  }

  html[data-theme="light"] .header-btn:hover {
    color: #0a0a0a;
  }

  html[data-theme="light"] .header-link:hover {
    color: #0a0a0a;
  }

  html[data-theme="light"] .footer-col a:hover,
  html[data-theme="light"] .footer-more:hover {
    color: #0a0a0a;
  }

  html[data-theme="light"] .lang-menu {
    background: #fff;
  }

  html[data-theme="light"] .lang-btn:hover,
  html[data-theme="light"] .lang-btn.active {
    color: #0a0a0a;
  }

  html[data-theme="light"] .hero-grid-bg {
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.05) 1px, transparent 1px);
  }

  html[data-theme="light"] .bg-reveal {
    display: none;
  }

  html[data-theme="light"] .hero-title,
  html[data-theme="light"] .hero-stat-value {
    color: #0a0a0a;
  }

  html[data-theme="light"] .word-2 {
    color: rgba(0, 0, 0, 0.3);
  }

  html[data-theme="light"] .hero-stat-label {
    color: rgba(0, 0, 0, 0.4);
  }

  html[data-theme="light"] .btn-flat {
    color: #0a0a0a;
  }

  html[data-theme="light"] .btn-flat::before {
    background: #0a0a0a;
  }

  html[data-theme="light"] .btn-flat:hover {
    color: #fff;
  }

  html[data-theme="light"] .scroll-line {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.35), transparent);
  }

  html[data-theme="light"] .footer-gradient-line {
    background: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.08) 20%, rgba(0, 0, 0, 0.15) 50%, rgba(0, 0, 0, 0.08) 80%, transparent 100%);
  }

  html[data-theme="light"] .footer-col-title {
    color: rgba(0, 0, 0, 0.45);
  }

  html[data-theme="light"] .footer-more {
    color: rgba(0, 0, 0, 0.35) !important;
  }

  html[data-theme="light"] .footer-copy {
    color: rgba(0, 0, 0, 0.4);
  }

  html[data-theme="light"] .footer-license {
    color: rgba(0, 0, 0, 0.3);
  }

  html[data-theme="light"] .btn-flat {
    color: #0a0a0a;
  }

  html[data-theme="light"] .btn-flat::before {
    background: #0a0a0a;
  }

  html[data-theme="light"] .btn-flat:hover {
    color: #fff;
  }

  html[data-theme="light"] .blog-title,
  html[data-theme="light"] .blog-card-title,
  html[data-theme="light"] .blog-card:hover,
  html[data-theme="light"] .blog-view-all:hover {
    color: #0a0a0a;
  }

  html[data-theme="light"] .blog-index,
  html[data-theme="light"] .blog-date,
  html[data-theme="light"] .blog-card-desc {
    color: rgba(0, 0, 0, 0.4);
  }

  html[data-theme="light"] .blog-tag {
    color: rgba(0, 0, 0, 0.35);
  }

  html[data-theme="light"] .changelog-label,
  html[data-theme="light"] .links-label,
  html[data-theme="light"] .contributors-label {
    color: rgba(0, 0, 0, 0.4);
  }

  html[data-theme="light"] .changelog-title,
  html[data-theme="light"] .links-title,
  html[data-theme="light"] .contributors-title,
  html[data-theme="light"] .link-title,
  html[data-theme="light"] .contributor-name {
    color: #0a0a0a;
  }

  html[data-theme="light"] .entry-date-label {
    color: rgba(0, 0, 0, 0.45);
  }

  html[data-theme="light"] .entry-right {
    color: rgba(0, 0, 0, 0.7);
  }

  html[data-theme="light"] .entry-right h3 {
    color: rgba(0, 0, 0, 0.45);
  }

  html[data-theme="light"] .entry-right li {
    color: rgba(0, 0, 0, 0.6);
  }

  html[data-theme="light"] .entry-right li::before {
    background: rgba(0, 0, 0, 0.3);
  }

  html[data-theme="light"] .expand-btn::before {
    background: #0a0a0a;
  }

  html[data-theme="light"] .expand-btn:hover {
    color: #fff;
  }

  html[data-theme="light"] .contributor-commits {
    color: rgba(0, 0, 0, 0.4);
  }

  html[data-theme="light"] .contributor-card:hover,
  html[data-theme="light"] .contributors-cta:hover {
    color: #0a0a0a;
  }


</style>
