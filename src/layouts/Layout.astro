---
import Footer from '../components/Footer.astro';
import DocsLinks from '../components/DocsLinks.astro';
import MigrationBanner from '../components/MigrationBanner.astro';
import { getLangFromLocals } from '../i18n/utils';
import { getFeaturedItems } from '../config/featured';
import { apps } from '../config/apps';
import { saas } from '../config/saas';

const lang = getLangFromLocals(Astro.locals);

interface Props {
  title: string;
  description?: string;
  image?: string;
  noFooter?: boolean;
  noindex?: boolean;
}

const { title, description = "Inled Group — Free, open and privacy-respecting software. Dream, Build.", image = "https://hosted.inled.es/hero-bg.jpg", noFooter = false, noindex = false } = Astro.props;

const SITE = 'https://inled.es';
const currentPath = Astro.locals.langPath ?? Astro.url.pathname;
const basePath = currentPath.replace(/^\/es(?=\/|$)/, '') || '/';
const enURL = new URL(basePath, Astro.site ?? SITE);
const esURL = new URL(basePath === '/' ? '/es/' : `/es${basePath}`, Astro.site ?? SITE);
const canonicalURL = lang === 'es' ? esURL : enURL;
const featuredItems = getFeaturedItems().filter(item => !item.archive);
const allProducts = [...saas, ...apps];
const isArchivedPage = allProducts.some(p => p.archive && (
  currentPath === p.link || 
  currentPath === p.link + '/' ||
  p.link === currentPath ||
  (p.id && currentPath.includes('/apps/' + p.id))
));

// Orden priorizado para Google Sitelinks: Pulsar OS, Inled Office, Seafari y CodexBar primero
const PRIORITY_NAV = ['Pulsar OS', 'InSuite', 'Seafari', 'CodexBar for GNOME'];

const toNavItem = (p: { name: string; link: string; archive?: boolean }) => ({
  name: p.name,
  url: p.link.startsWith('http') ? p.link : `https://inled.es${p.link}`,
});

const prioritizedNav = PRIORITY_NAV
  .map(name => allProducts.find(p => p.name === name && !p.archive))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .map(toNavItem);

const siteNavigation = [
  ...prioritizedNav,
  ...featuredItems.map(toNavItem).filter(n => !prioritizedNav.some(p => p.name === n.name)),
  { name: 'Contact', url: lang === 'es' ? 'https://inled.es/es/contacto' : 'https://inled.es/contacto' },
].slice(0, 8);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://inled.es/#organization",
      "name": "Inled Group",
      "url": "https://inled.es",
      "logo": {
        "@type": "ImageObject",
        "url": "https://hosted.inled.es/INLED_simple-removebg-preview.png"
      },
      "sameAs": [
        "https://github.com/InledGroup",
        "https://www.reddit.com/r/InledGroupCommunity/",
        "https://www.youtube.com/@inledgroup"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://inled.es/#website",
      "url": "https://inled.es",
      "name": "Inled Group",
      "publisher": { "@id": "https://inled.es/#organization" }
    },
    {
      "@type": "ItemList",
      "name": "Active Products",
      "itemListElement": siteNavigation.map((item, index) => ({
      	"@type": "ListItem",
      	"position": index + 1,
      	"name": item.name,
      	"url": item.url
      }))
    }
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Inled Group" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {noindex ? (
      <>
        <meta name="robots" content="noindex, nofollow, noarchive" />
        <meta name="googlebot" content="noindex, nofollow, noarchive" />
      </>
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}

    <link rel="dns-prefetch" href="https://hosted.inled.es">
    <link rel="preconnect" href="https://hosted.inled.es" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"></noscript>

    <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></noscript>

    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0"></noscript>
    <link rel="sitemap" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <meta name="theme-color" content="#f5f5f7" />

    <link rel="preload" as="image" href="/inled-logo-full.png" />

    <style is:inline>
      html.splash-active,
      html.splash-active body {
        overflow: hidden;
      }

      .splash {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        background: #f5f5f7;
        opacity: 1;
        visibility: visible;
        transition: opacity 0.45s ease, visibility 0.45s ease;
      }

      .splash--hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .splash-logo {
        width: auto;
        height: 40px;
        display: block;
      }

      .splash-track {
        width: 180px;
        height: 3px;
        border-radius: 999px;
        background: rgba(60, 60, 67, 0.14);
        overflow: hidden;
      }

      .splash-bar {
        display: block;
        width: 0;
        height: 100%;
        border-radius: inherit;
        background: #0071e3;
        transition: width 0.25s ease;
      }
    </style>

    <script is:inline type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "rkxkde17af");
        </script>

    <script is:inline>
      (function() {
        try {
          if (localStorage.getItem('inled-migration-banner-v2-closed') === 'true') {
            document.documentElement.classList.add('migration-banner-closed');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={isArchivedPage ? "archive-active-body" : ""}>
    <div class="splash" id="splash" role="status" aria-label={lang === 'es' ? 'Cargando' : 'Loading'}>
      <img class="splash-logo" src="/inled-logo-full.png" alt="Inled" />
      <div class="splash-track"><span class="splash-bar" id="splashBar"></span></div>
    </div>

    <script is:inline>
      (function () {
        const splash = document.getElementById('splash');
        const bar = document.getElementById('splashBar');
        if (!splash || !bar) return;

        document.documentElement.classList.add('splash-active');

        let progress = 6;
        let finished = false;
        bar.style.width = progress + '%';

        const tick = setInterval(function () {
          progress += Math.max(1, (92 - progress) * 0.06);
          bar.style.width = Math.min(progress, 92) + '%';
        }, 180);

        function finish() {
          if (finished) return;
          finished = true;
          clearInterval(tick);
          bar.style.width = '100%';

          setTimeout(function () {
            splash.classList.add('splash--hidden');
            document.documentElement.classList.remove('splash-active');
            setTimeout(function () { splash.remove(); }, 500);
          }, 320);
        }

        window.addEventListener('load', finish);
        if (document.readyState === 'complete') finish();
        setTimeout(finish, 9000);
      })();
    </script>

    {isArchivedPage && (
      <div class="archive-overlay-banner">
        <div class="archive-overlay-content">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.25rem;"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
          <span>
            {lang === 'es' 
              ? 'Este proyecto está archivado y no se mantiene activamente por ahora.' 
              : 'This project is archived and is not actively maintained for now.'}
          </span>
        </div>
      </div>
    )}
    <MigrationBanner />
    <slot />
    <DocsLinks />
    {!noFooter && <Footer />}
    <script>
      import Lenis from 'lenis';

      // Inicializar Lenis smooth scroll
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 2,
        infinite: false,
      });

      (window as any).lenis = lenis;

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    color-scheme: light;
    --migration-banner-height: 0px;

    --pixel-font: 'Press Start 2P', monospace;
    --sans-font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', 'Inter', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --font-features: 'cv02', 'cv03', 'cv04', 'cv11';

    --accent: #0071e3;
    --accent-hover: #0077ed;
    --accent-soft: rgba(0, 113, 227, 0.09);

    --bg: #f5f5f7;
    --surface: #ffffff;
    --surface-grouped: #f2f2f7;

    --text: #1d1d1f;
    --text-dim: #6e6e73;
    --text-muted: #86868b;
    --accent-dim: #6e6e73;

    --border: rgba(60, 60, 67, 0.14);
    --border-hover: rgba(60, 60, 67, 0.26);

    --card: transparent;
    --card-hover: rgba(118, 118, 128, 0.08);

    --fill: rgba(118, 118, 128, 0.12);
    --fill-text: #1d1d1f;
    --fill-dim: #6e6e73;

    --header-bg: rgba(245, 245, 247, 0.72);
  }

  html.migration-banner-closed {
    --migration-banner-height: 0px !important;
  }

  html.migration-banner-closed #migration-banner {
    display: none !important;
  }

  html {
    scroll-behavior: auto; /* Desactivar para que Lenis tome control */
  }

  body {
    font-family: var(--sans-font);
    font-feature-settings: var(--font-features);
    overflow-x: hidden;
    background: var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    padding-top: var(--migration-banner-height, 0px);
    transition: padding-top 0.25s ease;
  }

  html.lenis {
    height: auto;
  }

  .lenis.lenis-smooth {
    scroll-behavior: auto;
  }

  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }

  .lenis.lenis-stopped {
    overflow: hidden;
  }

  .lenis.lenis-scrolling iframe {
    pointer-events: none;
  }

  .archive-overlay-banner {
    position: fixed;
    top: var(--migration-banner-height, 0px);
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.82);
    border-bottom: 1px solid rgba(215, 0, 21, 0.18);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    color: #d70015;
    z-index: 10000;
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: top 0.25s ease;
  }

  .archive-overlay-content {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  body.archive-active-body .site-header {
    top: calc(3.5rem + var(--migration-banner-height, 0px)) !important;
  }

  .pixel-text {
    font-family: var(--pixel-font);
  }

  ::selection {
    background: var(--accent-soft);
  }
</style>
