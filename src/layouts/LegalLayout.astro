---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';

/**
 * ES: Interfaz de propiedades que acepta el Layout Legal.
 * EN: Props interface accepted by the Legal Layout.
 */
interface Props {
  title: string;
  description?: string;
  updatedAt?: string;
}

const { title, description, updatedAt } = Astro.props;
---

<Layout title={title} description={description}>
  <Header />

  <main class="legal-page">
    <article class="legal-container">
      {updatedAt && (
        <div class="legal-meta">
          <span class="update-tag">
            <i class="fa-regular fa-clock"></i>
            Última actualización: {updatedAt}
          </span>
        </div>
      )}

      <div class="legal-content">
        <slot />
      </div>
    </article>
  </main>
</Layout>

<style is:global>
  /*
    ES: Contenido renderizado desde Markdown.
    EN: Content rendered from Markdown.
  */
  .legal-content {
    font-family: var(--sans-font);
  }

  .legal-content h1 {
    color: var(--text);
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 600;
    margin-bottom: 2rem;
    text-align: left;
    line-height: 1.15;
    letter-spacing: -0.03em;
    background: none;
    -webkit-text-fill-color: currentColor;
  }

  .legal-content h2 {
    color: var(--text);
    font-size: 1.4rem;
    font-weight: 600;
    margin-top: 2.75rem;
    margin-bottom: 1.1rem;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.6rem;
  }

  .legal-content h3 {
    color: var(--text);
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .legal-content p {
    color: var(--text-dim);
    line-height: 1.8;
    font-size: 0.95rem;
    margin-bottom: 1.4rem;
  }

  .legal-content ul,
  .legal-content ol {
    margin-left: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--text-dim);
  }

  .legal-content li {
    margin-bottom: 0.7rem;
    line-height: 1.7;
  }

  .legal-content li strong {
    color: var(--text);
    font-weight: 600;
  }

  .legal-content a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-hover);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }

  .legal-content a:hover {
    text-decoration-color: var(--text);
  }

  .legal-content blockquote {
    border-left: 2px solid var(--border-hover);
    background: var(--surface);
    padding: 0.9rem 1.4rem;
    margin: 2rem 0;
    border-radius: 0;
    font-style: italic;
    color: var(--text-dim);
  }

  .legal-content blockquote p {
    margin-bottom: 0;
  }

  .legal-content hr {
    border: 0;
    height: 1px;
    background: var(--border);
    margin: 2.5rem 0;
  }

  .legal-content code {
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.15rem 0.4rem;
    border-radius: 0;
    font-size: 0.85em;
  }

  .legal-content pre {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0;
    padding: 1.1rem;
    overflow-x: auto;
  }

  .legal-content pre code {
    background: none;
    border: none;
    padding: 0;
  }

  @media (max-width: 768px) {
    .legal-content h1 {
      font-size: 1.9rem;
      margin-bottom: 1.5rem;
    }

    .legal-content h2 {
      font-size: 1.25rem;
      margin-top: 2rem;
    }

    .legal-content h3 {
      font-size: 1.05rem;
    }

    .legal-content p,
    .legal-content li {
      font-size: 0.9rem;
      line-height: 1.7;
    }
  }
</style>

<style>
  .legal-page {
    min-height: 100vh;
    padding: 8rem 5% 5rem;
    background: var(--bg);
  }

  .legal-container {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    padding: 3rem 2.75rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0;
    position: relative;
  }

  .legal-meta {
    display: flex;
    justify-content: flex-start;
    margin-bottom: 2rem;
  }

  .update-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sans-font);
    font-size: 0.65rem;
    color: var(--text-muted);
    background: var(--surface);
    padding: 0.4rem 0.8rem;
    border-radius: 0;
    border: 1px solid var(--border);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .update-tag i {
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .legal-page {
      padding: 6.5rem 1rem 3rem;
    }

    .legal-container {
      padding: 2rem 1.5rem;
    }

    .legal-meta {
      margin-bottom: 1.5rem;
    }
  }
</style>
