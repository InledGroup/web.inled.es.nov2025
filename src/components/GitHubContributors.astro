---
import { getLangFromLocals } from '../i18n/utils';

const lang = getLangFromLocals(Astro.locals);

interface Contributor {
  login: string;
  avatar_url: string;
  profile: string;
  contributions: number;
}

let inledContributors: Contributor[] = [];
let pulsarContributors: Contributor[] = [];

try {
  const [inledRes, pulsarRes] = await Promise.all([
    fetch('https://inledgroup.github.io/.github/contributors.json'),
    fetch('https://inled-pulsar-os.github.io/.github/contributors.json'),
  ]);

  if (inledRes.ok) {
    const data = await inledRes.json();
    inledContributors = (data.contributors || [])
      .sort((a: Contributor, b: Contributor) => b.contributions - a.contributions);
  }

  if (pulsarRes.ok) {
    const data = await pulsarRes.json();
    pulsarContributors = (data.contributors || [])
      .sort((a: Contributor, b: Contributor) => b.contributions - a.contributions);
  }
} catch {}

const seen = new Set<string>();
const marqueeContributors = [...inledContributors, ...pulsarContributors].filter((c) => {
  if (seen.has(c.login)) return false;
  seen.add(c.login);
  return true;
});

// Repeat the list so the row always fills the screen, then duplicate it for a seamless loop.
const minItems = 14;
const repeats = Math.max(1, Math.ceil(minItems / Math.max(marqueeContributors.length, 1)));
const loopGroup = Array.from({ length: repeats }, () => marqueeContributors).flat();
const marqueeDuration = Math.max(20, loopGroup.length * 2.6);

const discordContributors = [
  {
    name: 'Angelo',
    avatar: 'https://avatars.githubusercontent.com/u/332994032?s=128&v=4',
    role: { es: 'Interfaz y Liquid Glass', en: 'UI & Liquid Glass' },
  },
  {
    name: 'hhh',
    avatar: 'https://bittenfruit.inled.es/assets/people/hhh.png',
    role: { es: 'UI y diseño', en: 'UI & design' },
  },
  {
    name: 'Victor',
    avatar: 'https://bittenfruit.inled.es/assets/people/victor1890.png',
    role: { es: 'Frontend y web', en: 'Frontend & web' },
  },
];

const header = {
  es: { title: 'Reconociendo cada aportación', subtitle: 'Personas que han aportado su PR o tiempo a InledGroup' },
  en: { title: 'Recognizing each contribution', subtitle: 'People who have contributed their PR or time to InledGroup' },
}[lang];

const discordLabel = {
  es: 'Contribuidores en Discord',
  en: 'Discord contributors',
}[lang];

---

<section class="contributors-section">
  <div class="contributors-container">
    <div class="contributors-header">
      <div class="contributors-label">{lang === 'es' ? 'COMUNIDAD' : 'COMMUNITY'}</div>
      <h2 class="contributors-title">{header.title}</h2>
      <p class="contributors-subtitle">{header.subtitle}</p>
    </div>

    {marqueeContributors.length > 0 && (
      <div class="contributors-marquee">
        <div class="marquee-track" style={`--marquee-duration: ${marqueeDuration}s`}>
          {[0, 1].map((copy) => (
            <div class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
              {loopGroup.map((c) => (
                <a
                  href={c.profile}
                  target="_blank"
                  rel="noopener"
                  class="marquee-avatar"
                  tabindex={copy === 1 ? -1 : undefined}
                >
                  <img
                    src={`${c.avatar_url}?s=128&v=4`}
                    alt={copy === 1 ? '' : c.login}
                    loading="lazy"
                    width="48"
                    height="48"
                  />
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="discord-contributors">
      <div class="discord-head">
        <h3 class="group-title">{discordLabel}</h3>
      </div>
      <div class="discord-grid">
        {discordContributors.map((c) => (
          <div class="discord-card">
            <img class="discord-avatar" src={c.avatar} alt={c.name} loading="lazy" width="128" height="128" />
            <div class="discord-info">
              <span class="discord-name">{c.name}</span>
              <span class="discord-role">{c.role[lang]}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <a href="https://github.com/InledGroup" target="_blank" rel="noopener" class="contributors-cta">
      {lang === 'es' ? 'Ver en GitHub' : 'View on GitHub'}
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
    </a>
  </div>
</section>

<style>
  .contributors-section {
    width: 100%;
    background: var(--bg);
    border-top: 1px solid var(--border);
    overflow: hidden;
  }

  .contributors-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  .contributors-header {
    margin-bottom: 3rem;
  }

  .contributors-label {
    font-family: var(--sans-font);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin-bottom: 0.75rem;
  }

  .contributors-title {
    font-family: var(--sans-font);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin: 0 0 0.9rem 0;
  }

  .contributors-subtitle {
    font-family: var(--sans-font);
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    color: var(--text-dim);
    line-height: 1.55;
    margin: 0;
  }

  .contributors-marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 0.5rem 0;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: contributors-marquee var(--marquee-duration, 40s) linear infinite;
  }

  .contributors-marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-right: 0.75rem;
    flex-shrink: 0;
  }

  .marquee-avatar {
    display: block;
    flex-shrink: 0;
    border-radius: 50%;
    transition: transform 0.2s ease;
  }

  .marquee-avatar:hover {
    transform: scale(1.12);
  }

  .marquee-avatar img {
    display: block;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--border);
    object-fit: cover;
    background: var(--bg);
  }

  @keyframes contributors-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  .discord-contributors {
    margin-top: 3rem;
  }

  .discord-head {
    margin-bottom: 1.1rem;
  }

  .group-title {
    font-family: var(--sans-font);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .discord-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .discord-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(118, 118, 128, 0.06);
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .discord-card:hover {
    border-color: var(--accent);
    background: rgba(118, 118, 128, 0.1);
    transform: translateY(-2px);
  }

  .discord-avatar {
    display: block;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 1px solid var(--border);
    object-fit: cover;
    background: var(--bg);
    flex-shrink: 0;
  }

  .discord-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .discord-name {
    font-family: var(--sans-font);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .discord-role {
    font-family: var(--sans-font);
    font-size: 0.8rem;
    color: var(--text-dim);
    line-height: 1.35;
  }

  .contributors-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    font-family: var(--sans-font);
    font-size: 0.8rem;
    color: var(--accent-dim);
    text-decoration: none;
    transition: color 0.15s;
  }

  .contributors-cta:hover {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .contributors-container {
      padding: 4rem 1.25rem;
    }

    .marquee-avatar img {
      width: 42px;
      height: 42px;
    }
  }
</style>
