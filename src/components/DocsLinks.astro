---
import { getCollection } from 'astro:content';
import { getLangFromLocals, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromLocals(Astro.locals);
const localize = useTranslatedPath(lang);

const docs = (await getCollection('docs'))
  .filter((doc) => !doc.data.draft && !doc.id.split('/').pop()?.startsWith('_'))
  .sort(
    (a, b) =>
      (a.data.order ?? 100) - (b.data.order ?? 100) ||
      a.data.title.localeCompare(b.data.title),
  );
---

{docs.length > 0 && (
  <section class="docs-links" aria-labelledby="docs-links-title">
    <div class="docs-links-inner">
      <h2 id="docs-links-title" class="docs-links-title">
        {lang === 'es' ? 'Documentos' : 'Documents'}
      </h2>
      <ul class="docs-links-list">
        {docs.map((doc) => (
          <li>
            <a href={localize(`/docs/${doc.id}`)} class="docs-links-link">
              <span class="docs-links-copy">
                <span class="docs-links-name">{doc.data.title}</span>
                {doc.data.description && (
                  <span class="docs-links-desc">{doc.data.description}</span>
                )}
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .docs-links {
    border-top: 1px solid var(--border);
    padding: 3rem 1.5rem;
    background: var(--bg);
  }

  .docs-links-inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .docs-links-title {
    margin: 0 0 1.25rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .docs-links-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.75rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .docs-links-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    transition: color 0.18s ease;
  }

  .docs-links-link:hover {
    color: var(--accent);
  }

  .docs-links-link svg {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 0.18s ease, color 0.18s ease;
  }

  .docs-links-link:hover svg {
    color: var(--accent);
    transform: translateX(2px);
  }

  .docs-links-copy {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .docs-links-name {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .docs-links-desc {
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--text-dim);
  }

  @media (max-width: 560px) {
    .docs-links {
      padding: 2.5rem 1rem;
    }
  }
</style>
