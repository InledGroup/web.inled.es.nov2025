---
import { getLangFromLocals } from '../i18n/utils';
import { apps } from '../config/apps';
import { saas } from '../config/saas';

const lang = getLangFromLocals(Astro.locals);

const allProducts = [...saas, ...apps].filter(
  (product, index, list) => list.findIndex(p => p.id === product.id) === index
);

function findProduct(id: string) {
  return allProducts.find(p => p.id === id && !p.archive);
}

interface HeadlineProduct {
  id: string;
  repo: string;
  video?: string;
}

const headlineProducts: HeadlineProduct[] = [
  {
    id: 'office',
    repo: 'https://github.com/InledGroup/office',
  },
  {
    id: 'seafari',
    repo: 'https://github.com/InledGroup/seafari',
  },
  {
    id: 'codexbar-gnome',
    repo: 'https://github.com/InledGroup/codexbar-gnome',
  },
];

const PULSAR_VIDEO = 'https://hosted.inled.es/cdn/pulsar-pc-cool.mp4';

const pulsar = findProduct('pulsar-os');

const featured = headlineProducts
  .map(item => {
    const product = findProduct(item.id);
    if (!product) return null;
    return {
      id: product.id,
      name: product.name,
      description: product.description[lang],
      icon: product.icon,
      link: product.link,
      repo: item.repo,
    };
  })
  .filter((p): p is NonNullable<typeof p> => p !== null);

const featuredIds = ['pulsar-os', ...headlineProducts.map(p => p.id)];

const otherProducts = allProducts
  .filter(p => !p.archive && !featuredIds.includes(p.id))
  .map(p => ({
    id: p.id,
    name: p.name,
    description: p.description[lang],
    icon: p.icon,
    link: p.link,
  }));

const githubIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.012c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.483 0-.237-.009-.868-.013-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.004.07 1.532 1.032 1.532 1.032.892 1.53 2.341 1.088 2.91.832.091-.646.35-1.088.636-1.339-2.221-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.025A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.338 1.909-1.295 2.748-1.025 2.748-1.025.546 1.378.202 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.847-2.337 4.695-4.566 4.944.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.749 0 .268.18.579.688.481C19.138 20.174 22 16.426 22 12.012 22 6.484 17.523 2 12 2z"/></svg>`;
---

<section class="projects-section" id="projects">
  <div class="projects-container">
    <div class="section-head">
      <p class="section-eyebrow">{lang === 'es' ? 'Productos' : 'Products'}</p>
      <h2 class="section-title">{lang === 'es' ? 'Todo lo que construimos' : 'Everything we build'}</h2>
      <p class="section-subtitle">
        {lang === 'es'
          ? 'Software libre, privado y hecho para durar. Cada proyecto, abierto de extremo a extremo.'
          : 'Free, private software built to last. Every project, open end to end.'}
      </p>
    </div>

    {pulsar && (
      <article class="hero-product">
        <div class="hero-product-copy">
          <img src={pulsar.icon} alt={pulsar.name} class="hero-product-logo" loading="lazy" />
          <h3 class="hero-product-name">{pulsar.name}</h3>
          <p class="hero-product-desc">{pulsar.description[lang]}</p>
          <div class="card-actions">
            <a href={pulsar.link} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
              {lang === 'es' ? 'Descubrir' : 'Discover'}
            </a>
            <a href="https://github.com/Inled-Pulsar-OS/ISO" class="btn btn--ghost" target="_blank" rel="noopener noreferrer">
              <span set:html={githubIcon}></span>
              Repo
            </a>
          </div>
        </div>

        <a href={pulsar.link} class="hero-product-media" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
          <video
            class="hero-product-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            disablepictureinpicture
          >
            <source src={PULSAR_VIDEO} type="video/mp4" />
          </video>
        </a>
      </article>
    )}

    <div class="featured-grid">
      {featured.map((product) => (
        <article class="product-card">
          <div class="product-card-top">
            <img src={product.icon} alt={product.name} class="product-logo" loading="lazy" />
          </div>
          <h3 class="product-name">{product.name}</h3>
          <p class="product-desc">{product.description}</p>
          <div class="card-actions">
            <a href={product.link} class="btn btn--primary" target={product.link.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
              {lang === 'es' ? 'Descubrir' : 'Discover'}
            </a>
            <a href={product.repo} class="btn btn--ghost" target="_blank" rel="noopener noreferrer" aria-label={`${product.name} repo`}>
              <span set:html={githubIcon}></span>
              Repo
            </a>
          </div>
        </article>
      ))}
    </div>

    {otherProducts.length > 0 && (
      <div class="others">
        <h3 class="others-title">{lang === 'es' ? 'Más proyectos' : 'More projects'}</h3>
        <div class="others-grid">
          {otherProducts.map((product) => (
            <a href={product.link} class="other-card" target={product.link.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
              <img src={product.icon} alt="" class="other-logo" loading="lazy" />
              <span class="other-body">
                <span class="other-name">{product.name}</span>
                <span class="other-desc">{product.description}</span>
              </span>
              <svg class="other-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="archived-cta">
      <a href="/archivados" class="btn btn--ghost">
        {lang === 'es' ? 'Ver proyectos archivados' : 'View archived projects'}
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .projects-section {
    width: 100%;
    background: var(--bg);
    padding: 7rem 1.5rem 6rem;
  }

  .projects-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  .section-head {
    max-width: 720px;
    margin-bottom: 3rem;
  }

  .section-eyebrow {
    font-family: var(--sans-font);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.9rem;
  }

  .section-title {
    font-family: var(--sans-font);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--text);
    margin: 0 0 0.9rem;
  }

  .section-subtitle {
    font-family: var(--sans-font);
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    line-height: 1.55;
    color: var(--text-dim);
    margin: 0;
  }

  /* ---- Pulsar OS destacado ---- */
  .hero-product {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    gap: 3rem;
    padding: 3rem;
    border-radius: 30px;
    border: 1px solid var(--border);
    background:
      radial-gradient(circle at 15% 0%, rgba(80, 110, 255, 0.14), transparent 55%),
      var(--card);
    margin-bottom: 1.25rem;
    overflow: hidden;
  }

  .hero-product-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-product-logo {
    width: 64px;
    height: 64px;
    object-fit: contain;
    margin-bottom: 1.25rem;
  }

  .hero-product-name {
    font-family: var(--sans-font);
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--text);
    margin: 0 0 0.85rem;
  }

  .hero-product-desc {
    font-family: var(--sans-font);
    font-size: clamp(0.92rem, 1.4vw, 1.02rem);
    line-height: 1.6;
    color: var(--text-dim);
    margin: 0 0 1.75rem;
    max-width: 40ch;
  }

  .hero-product-media {
    display: block;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #050507;
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.8);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s ease;
  }

  .hero-product-media:hover {
    transform: translateY(-3px);
    border-color: var(--border-hover);
  }

  .hero-product-video {
    display: block;
    width: 100%;
    aspect-ratio: 882 / 462;
    object-fit: cover;
    background: #050507;
  }

  /* ---- Grid de productos principales ---- */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border-radius: 26px;
    border: 1px solid var(--border);
    background: var(--card);
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.3s ease;
  }

  .product-card:hover {
    background: var(--card-hover);
    border-color: var(--border-hover);
    transform: translateY(-3px);
  }

  .product-card-top {
    margin-bottom: 1.35rem;
  }

  .product-logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .product-name {
    font-family: var(--sans-font);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--text);
    margin: 0 0 0.6rem;
  }

  .product-desc {
    font-family: var(--sans-font);
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--text-dim);
    margin: 0 0 1.6rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-family: var(--sans-font);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1;
    padding: 0.65rem 1.05rem;
    border-radius: 980px;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .btn--primary {
    background: #0071e3;
    border: 1px solid #0071e3;
    color: #fff;
  }

  .btn--primary:hover {
    background: #0077ed;
    border-color: #0077ed;
  }

  .btn--ghost {
    background: transparent;
    border: 1px solid var(--border-hover);
    color: var(--text);
  }

  .btn--ghost:hover {
    background: var(--surface-hover);
  }

  /* ---- Otros proyectos ---- */
  .others {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  .others-title {
    font-family: var(--sans-font);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }

  .others-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
  }

  .other-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.15rem 1.25rem;
    background: var(--bg);
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .other-card:hover {
    background: var(--surface);
  }

  .other-logo {
    width: 30px;
    height: 30px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .other-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }

  .other-name {
    font-family: var(--sans-font);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .other-desc {
    font-family: var(--sans-font);
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .other-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: all 0.2s ease;
  }

  .other-card:hover .other-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .archived-cta {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  @media (max-width: 1024px) {
    .hero-product {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2.25rem;
    }

    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .projects-section {
      padding: 4.5rem 1rem 4rem;
    }

    .hero-product {
      padding: 1.75rem;
      border-radius: 24px;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .product-card {
      padding: 1.75rem;
      border-radius: 22px;
    }

    .others-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
