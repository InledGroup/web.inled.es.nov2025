---
import { getLangFromLocals, useTranslatedPath } from '../i18n/utils';
import { apps } from '../config/apps';
import { saas } from '../config/saas';

const lang = getLangFromLocals(Astro.locals);
const localize = useTranslatedPath(lang);
const t = (spanish: string, english: string) => (lang === 'es' ? spanish : english);

type Slide =
  | { type: 'video'; src: string; poster?: string; title?: string; desc?: string }
  | { type: 'image'; src: string; title?: string; desc?: string }
  | { type: 'placeholder'; title?: string; desc?: string };

const bittenfruitVideo = (name: string) => ({
  type: 'video' as const,
  src: `https://bittenfruit.inled.es/videos/${name}.webm`,
  poster: `https://bittenfruit.inled.es/videos/${name}.webp`,
});

const pulsarSlides: Slide[] = [
  { ...bittenfruitVideo('touch-face-id'), title: 'Touch & Face ID', desc: 'Touch ID and Face ID, with protection against identity theft' },
  { ...bittenfruitVideo('live-wallpaper'), title: 'Live Wallpapers', desc: 'Live wallpapers on the desktop and login screen. Lock screen support in progress.' },
  { ...bittenfruitVideo('liquid-glass'), title: 'Liquid Glass', desc: 'A gorgeous, translucent material design that flows across the UI. Depth, light, and refinement in every surface. Made by our contributor Angelo, expert in UI' },
  { ...bittenfruitVideo('notch'), title: 'Notch', desc: 'What you always wanted from the notch on your MacOS, and you had to install a thousand plugins, here it is all in one.' },
  { ...bittenfruitVideo('circle-to-search'), title: 'Circle to Search', desc: 'Shake the cursor, circle anything on your screen and search it on Google, ask Sayri about it, or grab the text with OCR.' },
  { ...bittenfruitVideo('firewall'), title: 'Pulsar Firewall', desc: "Pulsaros has UFW by default. The only firewall interfaze that's actually easy to configure. When an app tries to listen on a port, Pulsar asks you so you dont have to fight with firewall settings" },
  { ...bittenfruitVideo('global-menu'), title: 'Real Global Menu', desc: 'No Linux distro has this on GNOME. A true global menu bar at the top of the screen, just like macOS, for every app.' },
  { type: 'image' as const, src: 'https://hosted.inled.es/cdn/pulsar-vpn-static-pulsar-demos.png', title: 'Pulsar VPN', desc: 'Forget the headache of Wireguard: Pulsar OS comes with a simple interface for Tailscale, just log in and go' },
  { ...bittenfruitVideo('pulsar-windows'), title: 'Pulsar Windows', desc: "Windows apps as native apps on desktop. Below, a real Windows consuming as little as possible. You don't need to activate Windows to use it." },
  { ...bittenfruitVideo('encryption'), title: 'File vault (encryption)', desc: "Encrypt your drive and protect your data, so that if your computer is stolen, they don't steal the most important thing: its content." },
  { ...bittenfruitVideo('spotlight'), title: 'The Best Spotlight', desc: 'Say goodbye to the shitty spotlight that Apple created for the latest macOS. This spotlight is smart and can do a lot more things than the macOS one.' },
  { ...bittenfruitVideo('session-restore'), title: 'Session Restore', desc: 'Reboot or power on, and every app, window, and document reopens on its own. Pick up right where you left off. No Linux distro does this' },
  { ...bittenfruitVideo('sayri'), title: 'Sayri AI Assistant', desc: 'The safe, less expensive and functional alternative to Openclaw! try it now' },
  { ...bittenfruitVideo('window-mode'), title: 'Window Management', desc: 'Split view, Mission Control gestures, full screen on dynamic workspaces, and fluid window snapping built for power users.' },
  { ...bittenfruitVideo('nautilus-providers'), title: 'Finder, Rebuilt', desc: 'The file manager you already know: Mac-style navigation, previews, tags, and Google Drive, Dropbox, OneDrive, Nextcloud and 50+ cloud providers right where your files live.' },
  { ...bittenfruitVideo('app-store'), title: 'App Store', desc: 'Install any package (pkg, deb, aur, gnome extension, pulsar store), ask AI for security of an app and ask it what is the best app you need.' },
  { ...bittenfruitVideo('time-machine'), title: 'Time Machine', desc: 'Copies of your whole system, stored wherever you like: a network server, one of the 50 cloud providers, or a USB stick. If your computer ever breaks, put everything back.' },
  { ...bittenfruitVideo('recovery'), title: 'Recovery, Built In', desc: 'The only Linux distribution with an isolated recovery system, specifically designed for the most extreme cases, so you can recover your computer, your data and your system without losing files' },
  { ...bittenfruitVideo('remap-live-wallpaper'), title: 'Keyboard Remap', desc: 'Are you more of a Mac universe or do you prefer to keep the Linux and Windows commands? No problem: change all shortcuts from Mac to Linux and vice versa.' },
];

// PLACEHOLDER: sustituye estos slides por tus textos y fotos de InSuite.
const inSuiteSlides: Slide[] = [
  { type: 'image' as const, src: 'https://hosted.inled.es/cdn/word-demo-insuite.png', title: 'Full featured Word', desc: 'Edit, open and create word documents with 100% compatibility' },
  { type: 'image' as const, src: 'https://hosted.inled.es/cdn/powerpoint-demo-insuite.png', title: 'Your known features of PowerPoint', desc: 'Create the best presentations of powerpoint' },
  { type: 'image' as const, src: 'https://hosted.inled.es/cdn/excel-demo-insuite.png', title: 'EXCELlent', desc: 'Your spreadsheets, here' },
  { type: 'image' as const, src: 'https://hosted.inled.es/cdn/forms-demo-insuite.png', title: 'Private Forms', desc: 'Not like others !' },
  { type: 'image' as const, src: 'https://hosted.inled.es/cdn/mymetadata-demo-insuite.png', title: 'Remove and edit metadata and ai marks', desc: 'Without uploading the file to the cloud' },
  { type: 'image' as const, src: 'https://hosted.inled.es/cdn/mypdf-demo-insuite.png', title: 'Your full PDF suite', desc: 'Dont use ilovepdf!' },
];

const seafariSlides: Slide[] = [
  {
    type: 'video' as const,
    src: 'https://hosted.inled.es/cdn/seafari-user-agent-demo.mp4',
    title: t('User agent personalizado', 'Custom user agent'),
    desc: t(
      'Elige cómo se presenta Seafari en cada web y accede a las versiones que necesites.',
      'Choose how Seafari identifies itself on every site and access the versions you need.'
    ),
  },
    { type: 'image' as const, src: 'https://hosted.inled.es/cdn/seafari-v3-demo.png', title: 'New V3 with lots of improvements!', desc: 'Download it!' },

];

const features = [
  {
    id: 'pulsar-os',
    name: 'Pulsar OS',
    logo: 'https://hosted.inled.es/cdn/pulsar-logo-simple-sf.png',
    href: 'https://os.inled.es',
    cta: t('Probar Pulsar OS', 'Try Pulsar OS'),
    desc: t(
      'La distribución Linux que reemplaza a Mac y reemplazará a Windows y Android TV.',
      'The Linux distribution that replaces Mac and will replace Windows and Android TV.'
    ),
    tone: 'os',
    slides: pulsarSlides,
  },
  {
    id: 'office',
    name: 'InSuite',
    logo: 'https://hosted.inled.es/cdn/insuite.svg',
    href: 'https://insuite.inled.es',
    cta: t('Abrir InSuite', 'Open InSuite'),
    desc: t(
      'El Office privado y 100% compatible además de sus editores tipo ilovepdf o el borrador de metadatos privado y offline..',
      'The private and 100% compatible Office in addition to its ilovepdf type editors or the private and offline metadata eraser.'
    ),
    tone: 'suite',
    slides: inSuiteSlides,
  },
  {
    id: 'seafari',
    name: 'Seafari',
    logo: 'https://hosted.inled.es/seafari.png',
    href: '/apps/seafari',
    cta: t('Descubrir Seafari', 'Discover Seafari'),
    desc: t(
      'La experiencia de Safari en Linux, ya estable: cambia cómo te ven las webs y personaliza el navegador con live wallpapers.',
      'The Safari experience on Linux, now stable: switch how websites see you and make the browser yours with live wallpapers.'
    ),
    tone: 'browser',
    slides: seafariSlides,
  },
];

const allProducts = [...saas, ...apps].filter(
  (product, index, list) => list.findIndex(p => p.id === product.id) === index
);

// Los tres proyectos principales tienen su propia sección; el resto se lista debajo.
const FEATURED = ['pulsar-os', 'office', 'seafari'];
const HIDDEN = ['mypdf', 'mymetadata', 'droidtux', 'tabnest', 'mdpedia'];

const ORDER = [
  'iccount',
  'codexbar-gnome',
  'discord-translate',
  'appinstall',
  'ai-exporter',
];

const products = allProducts
  .filter(product => !product.archive && !FEATURED.includes(product.id) && !HIDDEN.includes(product.id))
  .sort((a, b) => {
    const ai = ORDER.indexOf(a.id);
    const bi = ORDER.indexOf(b.id);
    return (ai === -1 ? ORDER.length : ai) - (bi === -1 ? ORDER.length : bi);
  });
---

<section class="projects-section" id="projects">
  <div class="projects-container">
    <header class="section-head">
      <h2 class="section-title">{t('Diseñado para tí, para tu comodidad y privacidad', 'Designed for you, for your comfort and privacy')}</h2>
      <p class="section-subtitle">
        {t(
          'Descubre las mejores alternativas privadas, gratuitas y diseñadas para tí .',
          'Discover the best private, free alternatives designed for you'
        )}
      </p>
    </header>

    <div class="features">
      {features.map((feature) => {
        const external = feature.href.startsWith('http');
        return (
          <article class={`feature feature--${feature.tone}`}>
            <div class="feature-copy">
              <span class="feature-brand">
                <img src={feature.logo} alt="" loading="lazy" />
                <span>{feature.name}</span>
              </span>
              <p class="feature-desc">{feature.desc}</p>
              <a
                class="btn btn--primary"
                href={localize(feature.href)}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                {feature.cta}
              </a>
            </div>

            <div
              class="carousel"
              data-carousel
              data-label-prev={t('Anterior', 'Previous')}
              data-label-next={t('Siguiente', 'Next')}
              aria-roledescription="carousel"
            >
              <div class="carousel-viewport">
                <div class="carousel-track" data-track>
                {feature.slides.map((slide, index) => (
                  <figure
                    class:list={['carousel-slide', index === 0 && 'is-active', slide.title && 'has-caption']}
                    data-slide
                    aria-hidden={index === 0 ? 'false' : 'true'}
                  >
                    <span class="slide-media">
                      {slide.type === 'video' && (
                        <video
                          src={slide.src}
                          poster={slide.poster}
                          muted
                          loop
                          playsinline
                          preload="none"
                          aria-label={slide.title ?? feature.name}
                          data-slide-video
                        ></video>
                      )}
                      {slide.type === 'image' && (
                        <img src={slide.src} alt={slide.title ?? feature.name} loading="lazy" />
                      )}
                      {slide.type === 'placeholder' && (
                        <span class="slide-placeholder">
                          <img src={feature.logo} alt="" loading="lazy" />
                        </span>
                      )}
                    </span>

                    {slide.title && <span class="slide-shade" aria-hidden="true"></span>}

                    {slide.title && (
                      <figcaption class="slide-caption">
                        <span class="slide-title">{slide.title}</span>
                        {slide.desc && <span class="slide-desc">{slide.desc}</span>}
                      </figcaption>
                    )}
                  </figure>
                ))}
                </div>
              </div>

              {feature.slides.length > 1 && (
                <div class="carousel-controls">
                  <button class="carousel-arrow" type="button" data-prev aria-label={t('Anterior', 'Previous')}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                  </button>
                  <span class="carousel-count" data-count>1 / {feature.slides.length}</span>
                  <button class="carousel-arrow" type="button" data-next aria-label={t('Siguiente', 'Next')}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                  </button>
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>

    <div class="more">
      <h3 class="more-title">{t('Más del ecosistema', 'More from the ecosystem')}</h3>

      <div class="product-list">
        {products.map((product) => {
          const external = product.link.startsWith('http');
          return (
            <a
              class="product-row"
              href={localize(product.link)}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              <img class="product-icon" src={product.icon} alt="" loading="lazy" />
              <span class="product-copy">
                <span class="product-name">{product.name}</span>
                <span class="product-desc">{product.description[lang]}</span>
              </span>
              <span class="product-link">
                {t('Más información', 'Learn more')}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
              </span>
            </a>
          );
        })}
      </div>
    </div>

    <a class="archived-link" href={localize('/archivados')}>
      {t('Ver proyectos archivados', 'See archived projects')} →
    </a>

    <section class="brand-strategy">
      <div class="brand-strategy-copy">
        <h3 class="brand-strategy-title">
          {t('Estrategia de marca', 'Brand strategy')}
        </h3>
        <p class="brand-strategy-desc">
          {t(
            'Cómo organizamos la identidad y los proyectos de Inled.',
            'How we organize Inled’s identity and projects.'
          )}
        </p>
      </div>
      <a class="brand-strategy-link" href={localize('/brand-strategy')}>
        {t('Leer más', 'Learn more')}
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
      </a>
    </section>
  </div>
</section>

<script>
  function initCarousels() {
    const root = document.querySelectorAll<HTMLElement>('[data-carousel]');

    root.forEach((carousel) => {
      if (carousel.dataset.initialized === 'true') return;
      carousel.dataset.initialized = 'true';

      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-slide]'));
      const track = carousel.querySelector<HTMLElement>('[data-track]');
      const count = carousel.querySelector<HTMLElement>('[data-count]');
      const prev = carousel.querySelector<HTMLButtonElement>('[data-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-next]');
      if (slides.length < 2) return;

      let index = 0;
      let timer: number | undefined;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const playActiveVideo = () => {
        slides.forEach((slide, i) => {
          const video = slide.querySelector<HTMLVideoElement>('video');
          if (!video) return;
          if (i === index) video.play().catch(() => {});
          else video.pause();
        });
      };

      const updateTransform = () => {
        if (!track || !slides[index]) return;
        const offset = slides[index].offsetLeft - slides[0].offsetLeft;
        track.style.transform = `translateX(-${offset}px)`;
      };

      const go = (target: number) => {
        index = (target + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.classList.toggle('is-active', i === index);
          slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
        });
        if (count) count.textContent = `${index + 1} / ${slides.length}`;
        updateTransform();
        playActiveVideo();
      };

      const stop = () => window.clearInterval(timer);
      const start = () => {
        if (reducedMotion) return;
        stop();
        timer = window.setInterval(() => go(index + 1), 7000);
      };

      prev?.addEventListener('click', () => { go(index - 1); start(); });
      next?.addEventListener('click', () => { go(index + 1); start(); });

      carousel.addEventListener('mouseenter', stop);
      carousel.addEventListener('mouseleave', start);
      carousel.addEventListener('focusin', stop);
      carousel.addEventListener('focusout', start);

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            playActiveVideo();
            start();
          } else {
            stop();
            slides.forEach((slide) => slide.querySelector<HTMLVideoElement>('video')?.pause());
          }
        });
      }, { threshold: 0.25 });

      observer.observe(carousel);

      let resizeTimer: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(updateTransform, 120);
      });

      go(0);
    });
  }

  document.addEventListener('astro:page-load', initCarousels);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initCarousels();
  } else {
    document.addEventListener('DOMContentLoaded', initCarousels);
  }
</script>

<style>
  .projects-section {
    position: relative;
    padding: 5rem 1.5rem 6rem;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .projects-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  .section-head {
    max-width: 680px;
    margin-bottom: 1.5rem;
  }

  .section-eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .section-title {
    margin: 0;
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--text);
  }

  .section-subtitle {
    margin: 1rem 0 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--text-dim);
    text-wrap: pretty;
  }

  /* ---- Secciones principales ---- */
  .feature {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: 3.5rem;
    padding: 4rem 0;
    border-top: 1px solid var(--border);
  }

  .feature:first-child {
    border-top: none;
  }

  .feature:nth-child(even) {
    grid-template-columns: 1.2fr 0.8fr;
  }

  .feature:nth-child(even) .feature-copy {
    order: 2;
  }

  .feature-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .feature-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--sans-font);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .feature-brand img {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .feature-desc {
    margin: 1rem 0 1.75rem;
    font-family: var(--sans-font);
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--text-dim);
    max-width: 44ch;
    text-wrap: pretty;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 1.4rem;
    border-radius: 980px;
    font-family: var(--sans-font);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .btn:active {
    transform: scale(0.975);
  }

  .btn--primary {
    background: var(--accent);
    color: #fff;
  }

  .btn--primary:hover {
    background: var(--accent-hover);
  }

  /* ---- Carrusel ---- */
  .carousel {
    width: 100%;
    min-width: 0;
  }

  .carousel-viewport {
    overflow: hidden;
    /* Suaviza el corte de la diapositiva que asoma a la derecha */
    -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 84%, transparent 100%);
    mask-image: linear-gradient(90deg, #000 0%, #000 84%, transparent 100%);
  }

  .carousel-track {
    display: flex;
    gap: 1rem;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .carousel-slide {
    position: relative;
    flex: 0 0 86%;
    aspect-ratio: 16 / 9;
    margin: 0;
    border-radius: 22px;
    overflow: hidden;
    background: #0b0b0f;
    opacity: 0.4;
    transition: opacity 0.45s ease;
  }

  .carousel-slide.is-active {
    opacity: 1;
  }

  .slide-media {
    position: absolute;
    inset: 0;
    display: block;
  }

  .slide-media video,
  .slide-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .slide-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.32) 40%, rgba(0, 0, 0, 0.04) 72%),
      rgba(0, 0, 0, 0.14);
    pointer-events: none;
  }

  .slide-caption {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.4rem 1.5rem;
    text-align: left;
    margin: 0;
  }

  .slide-title {
    font-family: var(--sans-font);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #fff;
  }

  .slide-desc {
    font-family: var(--sans-font);
    font-size: 0.84rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.82);
    max-width: 48ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .slide-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, #f8f8fa, #e9e9ef);
  }

  .feature--os .slide-placeholder {
    background: linear-gradient(145deg, #eef3ff, #dfe7fb);
  }

  .feature--suite .slide-placeholder {
    background: linear-gradient(145deg, #eefaf4, #dcefe6);
  }

  .feature--browser .slide-placeholder {
    background: linear-gradient(145deg, #fff2ec, #f6e2d8);
  }

  .slide-media .slide-placeholder img {
    width: 26%;
    max-width: 120px;
    height: auto;
    object-fit: contain;
    opacity: 0.85;
  }

  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.9rem;
    margin-top: 1rem;
  }

  .carousel-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    transition: color 0.18s ease;
  }

  .carousel-arrow:hover {
    color: var(--accent);
  }

  .carousel-arrow:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
