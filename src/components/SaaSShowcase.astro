---
import { getLangFromLocals, useTranslations } from '../i18n/utils';
import { saas } from '../config/saas';
import { apps } from '../config/apps';

interface Props {
  ids: string[];
  badge?: string;
  title?: string;
  subtitle?: string;
}

const { ids, badge, title, subtitle } = Astro.props;

const lang = getLangFromLocals(Astro.locals);
const t = useTranslations(lang);

const allProducts = [...saas, ...apps];
const products = ids.map(id => allProducts.find(p => p.id === id)).filter(Boolean);
const count = products.length;
---

<section class="saas-showcase" data-count={count}>
  <div class="showcase-inner">
    <div class="showcase-header">
      {badge && <span class="badge">{badge}</span>}
      {title && <h2 class="showcase-title">{title}</h2>}
      {subtitle && <p class="showcase-subtitle">{subtitle}</p>}
    </div>

    <div class:list={["cards-row", `cards-count-${count}`]}>
      {products.map(p => (
        <a href={p.link} class="product-card">
          <div class="card-icon">
            <img src={p.icon} alt={p.name} loading="lazy" />
          </div>
          <h3 class="card-name">{p.name}</h3>
          <p class="card-desc">{p.description[lang]}</p>
        </a>
      ))}
    </div>

    <div class="sec-progress">
      <div class="sec-progress-bar">
        <div class="sec-progress-fill"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .saas-showcase {
    min-width: 100vw;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 3.5vh, 3.5rem) clamp(1.25rem, 3.5vw, 4rem);
    flex-shrink: 0;
    position: relative;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    background: rgba(0, 0, 0, 0.4);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    border-left: 1px solid rgba(255, 255, 255, 0.04);
    box-sizing: border-box;
    overflow: hidden;
  }

  .showcase-inner {
    width: 100%;
    max-width: 1400px;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vh, 2.75rem);
    height: 100%;
    max-height: 100%;
    justify-content: center;
    padding: clamp(0.5rem, 1.5vh, 1.5rem) 0;
    box-sizing: border-box;
  }

  .showcase-header {
    display: flex;
    flex-direction: column;
    gap: clamp(0.4rem, 1vh, 0.75rem);
    flex-shrink: 0;
  }

  .badge {
    display: inline-block;
    width: fit-content;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.35rem 0.9rem;
    border-radius: 100px;
    font-size: clamp(0.65rem, 0.8vw, 0.75rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .showcase-title {
    font-size: clamp(1.75rem, min(3.5vw, 5.5vh), 3.5rem);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #fff;
    margin: 0;
  }

  .showcase-subtitle {
    font-size: clamp(0.85rem, min(1.1vw, 2vh), 1.25rem);
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.5;
    max-width: 720px;
    margin: 0;
  }

  .cards-row {
    display: flex;
    gap: clamp(0.75rem, 1.5vw, 1.75rem);
    flex-wrap: nowrap;
    width: 100%;
    align-items: stretch;
    justify-content: flex-start;
    min-height: 0;
    overflow: visible;
  }

  .product-card {
    flex: 1 1 0px;
    min-width: 0;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: clamp(1.25rem, min(2vw, 3vh), 2.25rem) clamp(1rem, 1.5vw, 1.75rem);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: clamp(0.6rem, 1.4vh, 1.25rem);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: none;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  .product-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-4px);
  }

  .card-icon {
    width: clamp(38px, min(3.5vw, 5.5vh), 56px);
    height: clamp(38px, min(3.5vw, 5.5vh), 56px);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .card-name {
    font-size: clamp(1.05rem, min(1.3vw, 2.5vh), 1.4rem);
    font-weight: 800;
    color: #fff;
    margin: 0;
    line-height: 1.25;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .card-desc {
    font-size: clamp(0.82rem, min(0.95vw, 1.8vh), 1rem);
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  /* Specific count styling for optimal aesthetic density */
  .cards-count-1 .product-card {
    max-width: min(480px, 100%);
  }

  .cards-count-2 .product-card {
    max-width: min(440px, 100%);
  }

  .cards-count-3 .product-card {
    max-width: min(390px, 100%);
  }

  .cards-count-4 {
    gap: clamp(0.6rem, 1.2vw, 1.4rem);
  }
  .cards-count-4 .product-card {
    max-width: min(310px, 100%);
    padding: clamp(1rem, min(1.5vw, 2.5vh), 1.85rem) clamp(0.85rem, 1.2vw, 1.4rem);
    gap: clamp(0.5rem, 1vh, 1rem);
  }
  .cards-count-4 .card-icon {
    width: clamp(34px, min(2.8vw, 4.5vh), 48px);
    height: clamp(34px, min(2.8vw, 4.5vh), 48px);
  }
  .cards-count-4 .card-name {
    font-size: clamp(0.98rem, min(1.15vw, 2.2vh), 1.25rem);
  }
  .cards-count-4 .card-desc {
    font-size: clamp(0.78rem, min(0.88vw, 1.6vh), 0.92rem);
    line-height: 1.45;
  }

  .cards-count-5,
  .cards-row[class*="cards-count-"]:not(.cards-count-1):not(.cards-count-2):not(.cards-count-3):not(.cards-count-4) {
    gap: clamp(0.5rem, 1vw, 1.15rem);
  }
  .cards-count-5 .product-card,
  .cards-row[class*="cards-count-"]:not(.cards-count-1):not(.cards-count-2):not(.cards-count-3):not(.cards-count-4) .product-card {
    max-width: min(260px, 100%);
    padding: clamp(0.85rem, min(1.2vw, 2vh), 1.6rem) clamp(0.7rem, 1vw, 1.15rem);
    gap: clamp(0.45rem, 0.8vh, 0.85rem);
  }
  .cards-count-5 .card-icon,
  .cards-row[class*="cards-count-"]:not(.cards-count-1):not(.cards-count-2):not(.cards-count-3):not(.cards-count-4) .card-icon {
    width: clamp(30px, min(2.4vw, 4vh), 40px);
    height: clamp(30px, min(2.4vw, 4vh), 40px);
  }
  .cards-count-5 .card-name,
  .cards-row[class*="cards-count-"]:not(.cards-count-1):not(.cards-count-2):not(.cards-count-3):not(.cards-count-4) .card-name {
    font-size: clamp(0.9rem, min(1.05vw, 2vh), 1.15rem);
  }
  .cards-count-5 .card-desc,
  .cards-row[class*="cards-count-"]:not(.cards-count-1):not(.cards-count-2):not(.cards-count-3):not(.cards-count-4) .card-desc {
    font-size: clamp(0.74rem, min(0.82vw, 1.5vh), 0.88rem);
    line-height: 1.4;
  }

  .sec-progress {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: clamp(0.5rem, 1.5vh, 1rem);
    flex-shrink: 0;
  }

  .sec-progress-bar {
    width: min(200px, 40vw);
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 1px;
    overflow: hidden;
  }

  .sec-progress-fill {
    height: 100%;
    background: #ffffff;
    width: 0%;
  }

  @media (max-width: 1024px), (orientation: portrait) {
    .saas-showcase {
      min-width: 0;
      width: 100%;
      height: auto;
      padding: 5rem 1.5rem;
      border-left: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      overflow: visible;
    }

    .showcase-inner {
      height: auto;
      max-height: none;
      padding: 0;
      gap: 2rem;
    }

    .showcase-title {
      font-size: clamp(2rem, 6vw, 3rem);
    }

    .showcase-subtitle {
      font-size: clamp(1rem, 3.5vw, 1.25rem);
    }

    .cards-row {
      flex-direction: column;
      overflow: visible;
      gap: 1.25rem;
    }

    .product-card,
    .cards-count-1 .product-card,
    .cards-count-2 .product-card,
    .cards-count-3 .product-card,
    .cards-count-4 .product-card,
    .cards-count-5 .product-card,
    .cards-row[class*="cards-count-"] .product-card {
      min-width: 0 !important;
      max-width: 100% !important;
      width: 100% !important;
      flex: 1 1 auto !important;
      padding: 2rem 1.5rem !important;
      gap: 1rem !important;
    }

    .card-icon,
    .cards-count-4 .card-icon,
    .cards-count-5 .card-icon,
    .cards-row[class*="cards-count-"] .card-icon {
      width: 48px !important;
      height: 48px !important;
    }

    .card-name,
    .cards-count-4 .card-name,
    .cards-count-5 .card-name,
    .cards-row[class*="cards-count-"] .card-name {
      font-size: 1.25rem !important;
    }

    .card-desc,
    .cards-count-4 .card-desc,
    .cards-count-5 .card-desc,
    .cards-row[class*="cards-count-"] .card-desc {
      font-size: 0.95rem !important;
      line-height: 1.5 !important;
    }

    .sec-progress {
      display: none !important;
    }
  }

  @media (max-width: 768px) {
    .saas-showcase {
      padding: 4rem 1rem;
    }
  }
</style>
