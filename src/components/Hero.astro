---
import { getLangFromLocals, useTranslations } from '../i18n/utils';

const lang = getLangFromLocals(Astro.locals);
const t = useTranslations(lang);

const HERO_VIDEO = 'https://hosted.inled.es/cdn/demo-inled.mp4';
---

<section class="hero" id="hero">
  <video
    class="hero-bg-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    disablepictureinpicture
    aria-hidden="true"
    tabindex="-1"
  >
    <source src={HERO_VIDEO} type="video/mp4" />
  </video>

  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-fade" aria-hidden="true"></div>

  <div class="hero-content">
    <p class="hero-eyebrow">Inled Group</p>

    <h1 class="hero-title">
      <span class="hero-title-main">Dream,</span>
      <span class="hero-title-soft">Build.</span>
    </h1>

    <p class="hero-subtitle">{t('hero.subtitle')}</p>

    <div class="hero-actions">
      <a href="https://link.inled.es/discord" class="pill pill--primary" target="_blank" rel="noopener noreferrer">
        <i class="fa-brands fa-discord" aria-hidden="true"></i>
        {t('hero.btnDiscord')}
      </a>
      <a href="https://link.inled.es/telegram" class="pill pill--ghost" target="_blank" rel="noopener noreferrer">
        <i class="fa-brands fa-telegram" aria-hidden="true"></i>
        {t('hero.btnTelegram')}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 94svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 170px 1.5rem 9rem;
    background: #050507;
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse at 50% 45%, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.55) 72%),
      linear-gradient(180deg, rgba(3, 3, 6, 0.72) 0%, rgba(3, 3, 6, 0.42) 40%, rgba(3, 3, 6, 0.82) 100%);
    pointer-events: none;
  }

  .hero-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    height: 28%;
    min-height: 120px;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-eyebrow {
    font-family: var(--sans-font);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.66);
    margin: 0 0 1.1rem;
  }

  .hero-title {
    font-family: var(--sans-font);
    font-size: clamp(3.4rem, 10.5vw, 8rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.05em;
    margin: 0;
    color: #fff;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.35);
  }

  .hero-title-main {
    display: inline;
  }

  .hero-title-soft {
    display: inline;
    margin-left: 0.2em;
    background: linear-gradient(180deg, #fff 25%, rgba(255, 255, 255, 0.5) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-family: var(--sans-font);
    font-size: clamp(1rem, 2vw, 1.4rem);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.74);
    max-width: 620px;
    margin: 1.5rem 0 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--sans-font);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    padding: 0.85rem 1.6rem;
    border-radius: 980px;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
  }

  .pill--primary {
    background: #0071e3;
    color: #fff;
    border: 1px solid #0071e3;
  }

  .pill--primary:hover {
    background: #0077ed;
    border-color: #0077ed;
  }

  .pill--ghost {
    background: rgba(0, 0, 0, 0.25);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.45);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .pill--ghost:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.7);
  }

  :global(html[data-theme="light"]) .pill--ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.45);
  }

  :global(html[data-theme="light"]) .pill--ghost:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 88svh;
      padding: 130px 1.25rem 7rem;
    }
  }

  @media (max-width: 560px) {
    .hero {
      min-height: 86svh;
      padding: 118px 1rem 6rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
      gap: 0.6rem;
    }

    .pill {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-video {
      display: none;
    }
  }
</style>
