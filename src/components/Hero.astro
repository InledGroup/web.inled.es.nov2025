---
import { getLangFromLocals, useTranslations } from '../i18n/utils';

const lang = getLangFromLocals(Astro.locals);
const t = useTranslations(lang);

const stats = [
  { value: '+2m', label: { es: 'descargas un solo proyecto', en: 'downloads for only one project' } },
  { value: '+100', label: { es: 'proyectos software libre', en: 'open source projects' } },
  { value: '+1.800', label: { es: 'pushes en GitHub', en: 'pushes on GitHub' } },
];
---

<section class="hero" id="hero">
  <div class="hero-grid-bg"></div>
  <canvas id="bgReveal" class="bg-reveal"></canvas>

  <div class="hero-content">
    <h1 class="hero-title">
      <span class="word-1">Dream,</span>
      <span class="word-2">Build.</span>
    </h1>

    <p class="hero-subtitle">{t('hero.subtitle')}</p>

    <div class="hero-stats">
      {stats.map((s) => (
        <div class="hero-stat">
          <span class="hero-stat-value">{s.value}</span>
          <span class="hero-stat-label">{s.label[lang]}</span>
        </div>
      ))}
    </div>

    <div class="hero-actions">
      <a href="#projects" class="btn-flat btn-primary">
        <span>{lang === 'es' ? 'Ver Proyectos' : 'View Projects'}</span>
      </a>
      <!--  <a href="/servicios" class="btn-flat btn-accent">
        <span>{lang === 'es' ? 'Servicios' : 'Services'}</span>
      </a> -->
    </div>
  </div>

  <div class="hero-scroll">
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--bg);
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 40%, transparent 100%);
  }

  .bg-reveal {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 0 1.5rem;
    width: 100%;
    max-width: 900px;
  }

  .hero-title {
    font-family: var(--sans-font);
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 600;
    line-height: 1.05;
    color: #fff;
    letter-spacing: -0.04em;
    margin: 0;
  }

  .word-2 {
    color: rgba(255, 255, 255, 0.3);
  }

  .hero-subtitle {
    font-family: var(--mono-font);
    font-size: clamp(0.85rem, 1.8vw, 1rem);
    color: var(--accent-dim);
    max-width: 480px;
    line-height: 1.7;
    font-weight: 400;
  }

  .hero-stats {
    display: flex;
    gap: 2.5rem;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .hero-stat-value {
    font-family: var(--sans-font);
    font-size: 1.4rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.02em;
  }

  .hero-stat-label {
    font-family: var(--mono-font);
    font-size: 0.55rem;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .btn-flat {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.4rem;
    font-size: 0.7rem;
    text-decoration: none;
    transition: color 0.3s;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: var(--mono-font);
    font-weight: 700;
    position: relative;
    overflow: hidden;
    border: none;
    border-bottom: 1px solid var(--border);
  }

  .btn-flat::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }

  .btn-flat:hover::before {
    transform: scaleX(1);
  }

  .btn-flat:hover {
    color: #000;
  }

  .btn-flat > * {
    position: relative;
    z-index: 1;
  }

  .btn-primary {
    color: #fff;
  }

  .btn-accent {
    color: #fff;
  }

  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--border-hover), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 100svh;
      padding: 0 0 48px 0;
    }
    .hero-title {
      font-size: clamp(2.5rem, 14vw, 4rem);
    }
    .hero-stats {
      flex-direction: column;
      gap: 1rem;
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 280px;
    }
    .btn-flat {
      justify-content: center;
      width: 100%;
    }
  }
</style>

<script is:inline>
(function() {
  const bgCanvas = document.getElementById('bgReveal');
  if (!bgCanvas) return;
  const ctx = bgCanvas.getContext('2d');
  const bgImage = new Image();
  bgImage.src = 'https://hosted.inled.es/better.inled.png';
  let squares = [];

  function resize() {
    bgCanvas.width = bgCanvas.parentElement.offsetWidth;
    bgCanvas.height = bgCanvas.parentElement.offsetHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  const heroEl = document.getElementById('hero');
  if (heroEl) {
    heroEl.addEventListener('mousemove', (e) => {
      if (Math.random() > 0.7) return;
      const rect = heroEl.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const size = 40 + Math.random() * 100;
      squares.push({
        x: x - size / 2, y: y - size / 2,
        w: size, h: size,
        life: 1,
        decay: 0.005 + Math.random() * 0.01,
      });
    });
  }

  function draw() {
    ctx.clearRect(0, 0, bgCanvas.width, bgCanvas.height);
    if (bgImage.complete) {
      for (let i = squares.length - 1; i >= 0; i--) {
        const s = squares[i];
        s.life -= s.decay;
        if (s.life <= 0) { squares.splice(i, 1); continue; }
        ctx.globalAlpha = s.life * 0.12;
        ctx.drawImage(bgImage, s.x, s.y, s.w, s.h);
      }
    }
    ctx.globalAlpha = 1;
    requestAnimationFrame(draw);
  }
  draw();
})();
</script>
