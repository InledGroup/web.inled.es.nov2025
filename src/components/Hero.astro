---
import { getLangFromLocals, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromLocals(Astro.locals);
const localize = useTranslatedPath(lang);

const projects = [
  {
    name: 'Pulsar OS',
    logo: 'https://hosted.inled.es/cdn/pulsar-logo-simple-sf.png',
    href: 'https://os.inled.es',
  },
  {
    name: 'InSuite',
    logo: 'https://hosted.inled.es/cdn/insuite.svg',
    href: 'https://insuite.inled.es',
  },
  {
    name: 'Seafari',
    logo: 'https://hosted.inled.es/seafari.png',
    href: '/apps/seafari',
  },
  {
    name: 'iccount',
    logo: 'https://hosted.inled.es/cdn/inled-ring-v2-logo.png',
    href: 'https://iccount.inled.es',
  },
];

const copy = {
  es: {
    motto: 'Dream, Build.',
    title: 'El ecosistema privado, gratuito y hecho por la comunidad.',
    subtitle:
      'Descubre todo nuestro software diseñado pensando en tus necesidades. Todo el software de Inled, incluida la infra, es libre. Únete también a nuestra comunidad, que desarrolla Pulsar OS',
    primary: 'Únete en Discord',
    secondary: 'Chat en Telegram',
    donate: 'Ayudanos',
    projectsLabel: 'Esto es solo parte del ecosistema:',
  },
  en: {
    motto: 'Dream, Build.',
    title: 'The private, free ecosystem built by the community.',
    subtitle:
      'Discover all our software designed with your needs in mind. All Inled software, including the infra, is free. Also join our community, which develops Pulsar OS.',
    primary: 'Join Discord',
    secondary: 'Chat on Telegram',
    donate: 'Help us',
    projectsLabel: 'This is part of our ecosystem:0',
  },
}[lang];
---

<section class="hero" id="hero">
  <div class="hero-content">
    <p class="hero-motto">{copy.motto}</p>

    <h1 class="hero-title">{copy.title}</h1>

    <p class="hero-subtitle">{copy.subtitle}</p>

    <div class="hero-actions">
      <a href="https://link.inled.es/discord" class="btn btn--primary"><i class="fa-brands fa-discord" aria-hidden="true"></i>{copy.primary}</a>
      <a href="https://link.inled.es/telegram" class="btn btn--secondary" target="_blank" rel="noopener noreferrer">
        <i class="fa-brands fa-telegram" aria-hidden="true"></i>
        {copy.secondary}
      </a>
     <!--  <a href="https://donate.inled.es" class="btn btn--secondary">
        <i class="fa-solid fa-heart" aria-hidden="true"></i>
        {copy.donate}
      </a> -->
    </div>

    <div class="hero-projects">
      <p class="hero-projects-label">{copy.projectsLabel}</p>
      <div class="hero-logos">
        {projects.map((project) => (
          <a
            class="hero-logo"
            href={localize(project.href)}
            target={project.href.startsWith('http') ? '_blank' : undefined}
            rel={project.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            title={project.name}
          >
            <img src={project.logo} alt={project.name} loading="lazy" />
            <span>{project.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 170px 1.5rem 7rem;
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-motto {
    font-family: var(--sans-font);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent);
    margin: 0 0 1.1rem;
  }

  .hero-title {
    font-family: var(--sans-font);
    font-size: clamp(2.6rem, 6.4vw, 4.9rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.045em;
    margin: 0;
    color: var(--text);
    max-width: 900px;
    text-wrap: balance;
  }

  .hero-subtitle {
    font-family: var(--sans-font);
    font-size: clamp(1.05rem, 1.9vw, 1.3rem);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.012em;
    color: var(--text-dim);
    max-width: 620px;
    margin: 1.4rem 0 0;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 46px;
    padding: 0 1.5rem;
    border-radius: 980px;
    font-family: var(--sans-font);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .btn:active {
    transform: scale(0.975);
  }

  .btn--primary {
    background: var(--accent);
    color: #fff;
  }

  .btn--primary:hover {
    background: var(--accent-hover);
  }

  .btn--secondary {
    background: rgba(118, 118, 128, 0.12);
    color: var(--text);
  }

  .btn--secondary:hover {
    background: rgba(118, 118, 128, 0.18);
  }

  .hero-projects {
    margin-top: 4.5rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-projects-label {
    font-family: var(--sans-font);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }

  .hero-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: 1rem 2.5rem;
  }

  .hero-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    opacity: 0.72;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .hero-logo:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .hero-logo img {
    height: 30px;
    width: auto;
    max-width: 110px;
    object-fit: contain;
  }

  .hero-logo span {
    font-family: var(--sans-font);
    font-size: 0.7rem;
    color: var(--text-muted);
    letter-spacing: -0.005em;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 130px 1.25rem 5rem;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding: 118px 1rem 4rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }

    .btn {
      width: 100%;
    }

    .hero-projects {
      margin-top: 3.25rem;
    }

    .hero-logos {
      gap: 1rem 1.75rem;
    }

    .hero-logo img {
      height: 26px;
    }
  }
</style>
