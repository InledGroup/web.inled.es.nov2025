---
import { getLangFromLocals } from '../i18n/utils';

const lang = getLangFromLocals(Astro.locals);

const links = [
  {
    title: { es: 'Listado infraestructura', en: 'Infrastructure list' },
    desc: { es: 'Lista completa de servicios de Inled que mantienen vivo todo el proyecto', en: 'Complete list of Inled services that keep the entire project alive' },
    href: 'https://infra.inled.es',
  },
  {
    title: { es: 'Status', en: 'Status' },
    desc: { es: 'Comprueba el estado de todos los sitios y servidores', en: 'Check the status of all sites and servers' },
    href: 'https://status.inled.es',
  },
  {
    title: { es: 'Documentación', en: 'Documentation' },
    desc: { es: 'Documentación técnica y guías de uso', en: 'Technical documentation and usage guides' },
    href: 'https://help.inled.es',
  },
  {
    title: { es: 'Tablero de tareas', en: 'Task board' },
    desc: { es: 'Tareas de mantenimiento, errores y mejoras a aplicaciones', en: 'Maintenance tasks, bugs and improvements for apps' },
    href: 'https://github.com/orgs/InledGroup/projects/1/views/1',
  }
];

const header = {
  es: { title: 'Enlaces de interés', subtitle: 'Recursos útiles para la comunidad' },
  en: { title: 'Useful links', subtitle: 'Resources for the community' },
}[lang];
---

<section class="links-section">
  <div class="links-container">
    <div class="links-header">
      <div class="links-label">{lang === 'es' ? 'RECURSOS' : 'RESOURCES'}</div>
      <h2 class="links-title">{header.title}</h2>
      <p class="links-subtitle">{header.subtitle}</p>
    </div>

    <div class="links-list">
      {links.map((link, i) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="link-row" style={`animation-delay: ${i * 30}ms`}>
          <span class="link-index">{String(i + 1).padStart(2, '0')}</span>
          <div class="link-content">
            <span class="link-title">{link.title[lang]}</span>
            <span class="link-desc">{link.desc[lang]}</span>
          </div>
          <svg class="link-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .links-section {
    width: 100%;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .links-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 5%;
  }

  .links-header {
    margin-bottom: 3rem;
  }

  .links-label {
    font-family: var(--pixel-font);
    font-size: 0.5rem;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .links-title {
    font-family: var(--sans-font);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.03em;
    margin: 0 0 0.3rem 0;
  }

  .links-subtitle {
    font-family: var(--mono-font);
    font-size: 0.85rem;
    color: var(--accent-dim);
    margin: 0;
  }

  .links-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .link-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--accent-dim);
    position: relative;
    overflow: hidden;
    animation: linkIn 0.4s ease-out both;
  }

  .link-row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }

  .link-row:hover::before {
    transform: scaleX(1);
  }

  .link-row:hover {
    color: #000;
  }

  .link-row > * {
    position: relative;
    z-index: 1;
  }

  .link-row:last-child {
    border-bottom: none;
  }

  .link-index {
    font-family: var(--pixel-font);
    font-size: 0.5rem;
    color: rgba(255, 255, 255, 0.2);
    min-width: 24px;
  }

  .link-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .link-title {
    font-family: var(--sans-font);
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
    transition: color 0.2s;
  }

  .link-row:hover .link-title {
    color: #000;
  }

  .link-desc {
    font-family: var(--mono-font);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.35);
    transition: color 0.2s;
  }

  .link-row:hover .link-desc {
    color: rgba(0, 0, 0, 0.5);
  }

  .link-arrow {
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .link-row:hover .link-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  @keyframes linkIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
