---
import { getPosts, formatDate } from '../lib/blogger';
import { getLangFromLocals } from '../i18n/utils';

const lang = getLangFromLocals(Astro.locals);
const posts = await getPosts();
const latestPosts = posts.slice(0, 4);
---

<section class="blog-section" id="blog">
  <div class="blog-container">
    <div class="blog-header">
      <h2 class="blog-title">{lang === 'es' ? 'Blog' : 'Blog'}</h2>
      <p class="blog-subtitle">{lang === 'es' ? 'Últimas novedades' : 'Latest updates'}</p>
    </div>

    <div class="blog-grid">
      {latestPosts.map((post, i) => (
        <a href={`/blog/${post.slug}`} class="blog-card" data-thumb={post.thumbnail || ''} style={`animation-delay: ${i * 60}ms`}>
          <div class="card-bg" style={`background-image: url(${post.thumbnail || ''})`}></div>
          <div class="card-content">
            <div class="card-top">
              <span class="blog-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="blog-date">{formatDate(post.published)}</span>
            </div>
            <h3 class="blog-card-title">{post.title}</h3>
            <p class="blog-card-desc"></p>
            <div class="card-bottom">
              {post.tags.length > 0 && (
                <div class="blog-tags">
                  {post.tags.slice(0, 2).map(tag => (
                    <span class="blog-tag">{tag}</span>
                  ))}
                </div>
              )}
              <svg class="blog-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <a href="/blog" class="blog-view-all">
      {lang === 'es' ? 'Ver todo el blog' : 'View all posts'}
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</section>

<style>
  .blog-section {
    position: relative;
    width: 100%;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .blog-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 5%;
  }

  .blog-header {
    margin-bottom: 3rem;
  }

  .blog-title {
    font-family: var(--sans-font);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.03em;
    margin-bottom: 0.3rem;
  }

  .blog-subtitle {
    font-family: var(--mono-font);
    font-size: 0.85rem;
    color: var(--accent-dim);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .blog-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0;
    background: var(--bg);
    text-decoration: none;
    color: var(--accent-dim);
    overflow: hidden;
    animation: cardIn 0.4s ease-out both;
    min-height: 200px;
  }

  .card-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
  }

  .blog-card:hover .card-bg {
    opacity: 0.15;
  }

  .card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    height: 100%;
    background: var(--bg);
    transition: background 0.3s ease;
  }

  .blog-card:hover .card-content {
    background: transparent;
  }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .blog-card:hover {
    color: #fff;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .blog-index {
    font-family: var(--pixel-font);
    font-size: 0.5rem;
    color: rgba(255, 255, 255, 0.2);
  }

  .blog-date {
    font-family: var(--mono-font);
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .blog-card-title {
    font-family: var(--sans-font);
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    margin: 0;
    line-height: 1.3;
  }

  .blog-card-desc {
    font-family: var(--mono-font);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.35);
    line-height: 1.5;
    flex: 1;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    margin: 0;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .blog-tags {
    display: flex;
    gap: 0.3rem;
  }

  .blog-tag {
    font-family: var(--mono-font);
    font-size: 0.5rem;
    color: rgba(255, 255, 255, 0.25);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border: 1px solid var(--border);
    padding: 0.15rem 0.4rem;
  }

  .blog-arrow {
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: all 0.2s;
  }

  .blog-card:hover .blog-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .blog-view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--mono-font);
    font-size: 0.8rem;
    color: var(--accent-dim);
    text-decoration: none;
    transition: color 0.15s;
  }

  .blog-view-all:hover {
    color: #fff;
  }

  @media (max-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
    .blog-container { padding: 3rem 5%; }
  }
</style>
