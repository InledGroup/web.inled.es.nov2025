---
import { getLangFromLocals } from '../i18n/utils';

const lang = getLangFromLocals(Astro.locals);

const t = {
  es: {
    title: 'Únete a la comunidad',
    subtitle: 'Somos una comunidad amigable: comparte ideas, pide ayuda y participa en lo que construimos.',
    discord: 'Únete a Discord',
    telegram: 'Únete a Telegram',
    githubTitle: 'Todo nuestro código es open source',
    githubDesc: 'Verificable de extremo a extremo en GitHub: desde esta web hasta cada una de nuestras apps.',
  },
  en: {
    title: 'Join the community',
    subtitle: "We're a friendly community: share ideas, ask for help and take part in what we build.",
    discord: 'Join Discord',
    telegram: 'Join Telegram',
    githubTitle: 'All our code is open source',
    githubDesc: 'Verifiable end-to-end on GitHub: from this website to every one of our apps.',
  },
}[lang];
---

<section class="community-section">
  <div class="community-panel">
    <div class="community-glow" aria-hidden="true"></div>

    <h2 class="community-title">{t.title}</h2>
    <p class="community-subtitle">{t.subtitle}</p>

    <div class="community-actions">
      <a href="https://link.inled.es/discord" target="_blank" rel="noopener" class="pill pill--primary">
        <i class="fa-brands fa-discord" aria-hidden="true"></i>
        {t.discord}
      </a>
      <a href="https://link.inled.es/telegram" target="_blank" rel="noopener" class="pill pill--ghost">
        <i class="fa-brands fa-telegram" aria-hidden="true"></i>
        {t.telegram}
      </a>
    </div>

    <a href="https://github.com/InledGroup" target="_blank" rel="noopener" class="github-row">
      <i class="fa-brands fa-github github-icon" aria-hidden="true"></i>
      <span class="github-text">
        <span class="github-name">{t.githubTitle}</span>
        <span class="github-desc">{t.githubDesc}</span>
      </span>
      <svg class="github-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
    </a>
  </div>
</section>

<style>
  .community-section {
    width: 100%;
    background: var(--bg);
    padding: 3rem 1.5rem 6rem;
  }

  .community-panel {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    padding: 5.5rem 2rem 4rem;
    border: 1px solid var(--border);
    border-radius: 32px;
    background: var(--card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    isolation: isolate;
  }

  .community-glow {
    position: absolute;
    top: -60%;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 600px;
    background: radial-gradient(ellipse at center, rgba(88, 101, 242, 0.22), transparent 65%);
    pointer-events: none;
    z-index: -1;
  }

  .community-title {
    font-family: var(--sans-font);
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.04;
    color: var(--text);
    margin: 0 0 1rem;
  }

  .community-subtitle {
    font-family: var(--sans-font);
    font-size: clamp(0.98rem, 1.7vw, 1.15rem);
    line-height: 1.55;
    color: var(--text-dim);
    max-width: 560px;
    margin: 0;
  }

  .community-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--sans-font);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    padding: 0.85rem 1.6rem;
    border-radius: 980px;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .pill--primary {
    background: #0071e3;
    border: 1px solid #0071e3;
    color: #fff;
  }

  .pill--primary:hover {
    background: #0077ed;
    border-color: #0077ed;
  }

  .pill--ghost {
    background: transparent;
    border: 1px solid rgba(41, 151, 255, 0.55);
    color: #2997ff;
  }

  .pill--ghost:hover {
    background: rgba(41, 151, 255, 0.1);
    border-color: #2997ff;
  }

  :global(html[data-theme="light"]) .pill--ghost {
    color: #06c;
    border-color: rgba(0, 102, 204, 0.45);
  }

  :global(html[data-theme="light"]) .pill--ghost:hover {
    background: rgba(0, 102, 204, 0.07);
    border-color: #06c;
  }

  .github-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    max-width: 560px;
    margin-top: 3.5rem;
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    transition: color 0.2s ease;
  }

  .github-icon {
    font-size: 1.3rem;
    line-height: 1;
    flex-shrink: 0;
    color: var(--text);
  }

  .github-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
    text-align: left;
  }

  .github-name {
    font-family: var(--sans-font);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .github-desc {
    font-family: var(--sans-font);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .github-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .github-row:hover .github-arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 700px) {
    .community-section {
      padding: 2rem 1rem 4rem;
    }

    .community-panel {
      padding: 4rem 1.25rem 3rem;
      border-radius: 26px;
    }

    .community-actions {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }

    .pill {
      width: 100%;
    }

    .github-row {
      margin-top: 2.75rem;
    }
  }
</style>
