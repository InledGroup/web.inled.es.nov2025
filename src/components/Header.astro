---
import { getLangFromLocals, useTranslations } from '../i18n/utils';

const lang = getLangFromLocals(Astro.locals);
const t = useTranslations(lang);
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo" aria-label="Home">
      <img src="https://hosted.inled.es/inled-logo-full.png" alt="Inled" class="logo-img" />
    </a>

    <nav class="header-center">
      <a href="#projects" class="header-link">{lang === 'es' ? 'Proyectos' : 'Projects'}</a>
      <a href="/blog" class="header-link">Blog</a>
     <!--  <a href="/servicios" class="header-link header-link--accent">{lang === 'es' ? 'Servicios' : 'Services'}</a>-->
      <a href="/contacto" class="header-link">{t('nav.contact')}</a>

      <span class="header-divider"></span>

      <a href="https://github.com/InledGroup" target="_blank" rel="noopener" class="header-btn" aria-label="GitHub">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.012c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.483 0-.237-.009-.868-.013-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.004.07 1.532 1.032 1.532 1.032.892 1.53 2.341 1.088 2.91.832.091-.646.35-1.088.636-1.339-2.221-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.025A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.338 1.909-1.295 2.748-1.025 2.748-1.025.546 1.378.202 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.847-2.337 4.695-4.566 4.944.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.749 0 .268.18.579.688.481C19.138 20.174 22 16.426 22 12.012 22 6.484 17.523 2 12 2z"/></svg>
      </a>
      <a href="https://link.inled.es/discord" target="_blank" rel="noopener" class="header-btn" aria-label="Discord">
        <i class="fa-brands fa-discord" style="font-size: 15px;"></i>
      </a>
      <a href="https://link.inled.es/telegram" target="_blank" rel="noopener" class="header-btn" aria-label="Discord">
        <i class="fa-brands fa-telegram" style="font-size: 15px;"></i>
      </a>
