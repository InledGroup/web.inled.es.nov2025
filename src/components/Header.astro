      </a>
      <a href="https://www.youtube.com/@inledgroup" target="_blank" rel="noopener" class="header-btn" aria-label="YouTube">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M21.8 8.001s-.2-1.429-.8-2.057c-.763-.8-1.617-.803-2.011-.849C16.2 5 12 5 12 5h-.01s-4.2 0-7 .095c-.394.046-1.248.049-2.011.849-.6.628-.8 2.057-.8 2.057S2 9.571 2 11.143v1.714c0 1.572.2 3.142.2 3.142s.2 1.429.8 2.057c.763.8 1.767.775 2.221.86C7.8 19 12 19 12 19s4.2 0 7-.095c.394-.046 1.248-.049 2.011-.849.6-.628.8-2.057.8-2.057s.2-1.57.2-3.142v-1.714c0-1.572-.2-3.142-.2-3.142zM10 15.5v-7l6 3.5-6 3.5z"/></svg>
      </a>

      <span class="header-divider"></span>

      <div class="lang-selector-container">
        <button class="header-btn lang-toggle" aria-label="Change Language">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/></svg>
        </button>
        <div class="lang-menu">
          <button class={`lang-btn ${lang === 'es' ? 'active' : ''}`} data-lang="es">ES</button>
          <button class={`lang-btn ${lang === 'en' ? 'active' : ''}`} data-lang="en">EN</button>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2000;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    height: 48px;
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: #fff;
    flex-shrink: 0;
  }

  .logo-img {
    width: auto;
    height: 30px;
    object-fit: contain;
  }

  .logo-text {
    font-family: var(--mono-font);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    color: #fff;
  }

  .header-center {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .header-divider {
    width: 1px;
    height: 16px;
    background: var(--border);
    margin: 0 0.3rem;
  }

  .header-link {
    font-size: 0.75rem;
    color: var(--accent-dim);
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    font-weight: 500;
    transition: color 0.15s;
    font-family: var(--mono-font);
    letter-spacing: 0.02em;
  }

  .header-link:hover {
    color: #fff;
  }

  .header-link--accent {
    color: var(--accent);
    font-weight: 600;
  }

  .header-link--accent:hover {
    color: #fff;
  }

  .header-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: var(--accent-dim);
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }

  .header-btn:hover {
    color: #fff;
    background: var(--surface-hover);
  }

  .lang-selector-container {
    position: relative;
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: #111;
    border: 1px solid var(--border);
    padding: 4px;
    min-width: 56px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: all 0.15s;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .lang-selector-container.open .lang-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .lang-btn {
    background: transparent;
    border: none;
    color: var(--accent-dim);
    padding: 0.35rem 0.6rem;
    font-size: 0.7rem;
    font-family: var(--mono-font);
    cursor: pointer;
    text-align: center;
    transition: all 0.15s;
  }

  .lang-btn:hover {
    background: var(--surface-hover);
    color: #fff;
  }

  .lang-btn.active {
    color: #fff;
    background: var(--surface);
  }

  @media (max-width: 768px) {
    .header-link { display: none; }
    .header-inner { padding: 0 1rem; }
  }
</style>

<script>
  function initHeader() {
    const langSelector = document.querySelector('.lang-selector-container');
    const langToggle = document.querySelector('.lang-toggle');

    langToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      langSelector?.classList.toggle('open');
    });

    const langBtns = document.querySelectorAll('.lang-btn');
    langBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const lang = (e.currentTarget as HTMLElement).dataset.lang;
        if (lang) {
          document.cookie = `preferred-lang=${lang}; path=/; max-age=${60*60*24*365}; SameSite=Lax`;
          localStorage.setItem('preferred-lang', lang);
          window.location.reload();
        }
      });
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.lang-selector-container')) {
        langSelector?.classList.remove('open');
      }
    });
  }

  document.addEventListener('astro:page-load', initHeader);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initHeader();
  } else {
    document.addEventListener('DOMContentLoaded', initHeader);
  }
</script>
