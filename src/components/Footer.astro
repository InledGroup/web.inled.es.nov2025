---
import { getLangFromLocals, useTranslations, useTranslatedPath } from '../i18n/utils';
import { getFeaturedItems } from '../config/featured';

const lang = getLangFromLocals(Astro.locals);
const t = useTranslations(lang);
const translatePath = useTranslatedPath();

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-gradient-line"></div>

  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="https://hosted.inled.es/inled-logo-full.png" alt="Inled" />
        </a>
        <p class="footer-desc">{t('footer.description')}</p>
      </div>

      <div class="footer-grid">
        <div class="footer-col">
          <h4 class="footer-col-title">{lang === 'es' ? 'Proyectos' : 'Projects'}</h4>
          <a href="https://office.inled.es" target="_blank" rel="noopener">Insuite Office</a>
          <a href="https://start.inled.es" target="_blank" rel="noopener">Start</a>
          <a href="https://os.inled.es" target="_blank" rel="noopener">Pulsar OS</a>
          <a href="https://edge.inled.es/landing" target="_blank" rel="noopener">Edge AI</a>
          <a href="#projects" class="footer-more">{lang === 'es' ? 'Ver todos' : 'View all'}</a>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">{lang === 'es' ? 'Recursos' : 'Resources'}</h4>
          <a href="/blog">Blog</a>
          <a href="https://github.com/InledGroup" target="_blank" rel="noopener">GitHub</a>
          <a href="https://link.inled.es/discord" target="_blank" rel="noopener">Discord</a>
          <a href="https://matrix.inled.es" target="_blank" rel="noopener">Matrix</a>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">{t('footer.legaltitle')}</h4>
          <a href={translatePath('/aviso-legal')}>{t('footer.legal')}</a>
          <a href={translatePath('/privacy-policy')}>{t('footer.privacy')}</a>
          <a href={translatePath('/cookie-policy')}>{t('footer.cookies')}</a>
          <a href={translatePath('/eu-ai-act')}>{t('footer.aiact')}</a>
          <a href={translatePath('/contacto')}>{t('nav.contact')}</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">&copy; {year} Inled Group. {lang === 'es' ? 'Todos los derechos reservados.' : 'All rights reserved.'}</span>
      <span class="footer-license">MIT-INLED</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--bg);
    padding: 0 1.5rem;
  }

  .footer-gradient-line {
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.08) 20%,
      rgba(255, 255, 255, 0.15) 50%,
      rgba(255, 255, 255, 0.08) 80%,
      transparent 100%
    );
    margin-bottom: 4rem;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #fff;
  }

  .footer-logo img {
    width: auto;
    height: 40px;
    object-fit: contain;
  }

  .footer-logo span {
    font-family: var(--mono-font);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.15em;
  }

  .footer-desc {
    font-family: var(--mono-font);
    font-size: 0.8rem;
    color: var(--accent-dim);
    line-height: 1.6;
    max-width: 280px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-col-title {
    font-family: var(--mono-font);
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 0.4rem;
  }

  .footer-col a {
    font-family: var(--mono-font);
    font-size: 0.8rem;
    color: var(--accent-dim);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-col a:hover {
    color: #fff;
  }

  .footer-more {
    font-size: 0.75rem !important;
    color: rgba(255, 255, 255, 0.3) !important;
    margin-top: 0.3rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
  }

  .footer-copy {
    font-family: var(--mono-font);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .footer-license {
    font-family: var(--pixel-font);
    font-size: 0.5rem;
    color: rgba(255, 255, 255, 0.2);
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
