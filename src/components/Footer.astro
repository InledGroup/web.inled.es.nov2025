---
import { getLangFromLocals, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromLocals(Astro.locals);
const t = useTranslations(lang);
const localize = useTranslatedPath(lang);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={localize('/')} class="footer-logo">
          <img src="/inled-logo-full.png" alt="Inled" />
        </a>
        <p class="footer-desc">{t('footer.description')}</p>
      </div>

      <div class="footer-grid">
        <div class="footer-col">
          <h4 class="footer-col-title">{lang === 'es' ? 'Proyectos' : 'Projects'}</h4>
          <a href="https://insuite.inled.es" target="_blank" rel="noopener">InSuite</a>
          <a href={localize('/apps/seafari')}>Seafari</a>
          <a href="https://os.inled.es" target="_blank" rel="noopener">Pulsar OS</a>
          <a href={localize('/apps/codexbar-gnome')}>CodexBar</a>
          <a href={localize('/#projects')} class="footer-more">{lang === 'es' ? 'Ver todos' : 'View all'}</a>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">{lang === 'es' ? 'Recursos' : 'Resources'}</h4>
          <a href={localize('/blog')}>Blog</a>
          <a href="https://github.com/InledGroup" target="_blank" rel="noopener">GitHub</a>
          <a href="https://link.inled.es/discord" target="_blank" rel="noopener">Discord</a>
          <a href="https://matrix.inled.es" target="_blank" rel="noopener">Matrix</a>
          <a href="https://hosted.inled.es/" target="_blank" rel="noopener">Press Kit</a>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">{t('footer.legaltitle')}</h4>
          <a href={localize('/aviso-legal')}>{t('footer.legal')}</a>
          <a href={localize('/privacy-policy')}>{t('footer.privacy')}</a>
          <a href={localize('/cookie-policy')}>{t('footer.cookies')}</a>
          <a href={localize('/eu-ai-act')}>{t('footer.aiact')}</a>
          <a href={localize('/contacto')}>{t('nav.contact')}</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">&copy; {year} Inled Group. {lang === 'es' ? 'Todos los derechos reservados.' : 'All rights reserved.'}</span>
      <span class="footer-license">MIT-INLED</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--bg);
    padding: 0 1.5rem;
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 4rem;
    padding: 3.5rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .footer-logo img {
    width: auto;
    height: 34px;
    object-fit: contain;
  }

  .footer-desc {
    font-family: var(--sans-font);
    font-size: 0.8125rem;
    color: var(--text-dim);
    line-height: 1.6;
    max-width: 280px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-col-title {
    font-family: var(--sans-font);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .footer-col a {
    font-family: var(--sans-font);
    font-size: 0.8125rem;
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-more {
    font-size: 0.8125rem !important;
    color: var(--accent) !important;
    margin-top: 0.2rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
  }

  .footer-copy,
  .footer-license {
    font-family: var(--sans-font);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .footer-license {
    letter-spacing: 0.08em;
  }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
