---
import { getLangFromLocals } from '../i18n/utils';

const lang = getLangFromLocals(Astro.locals);

const t = {
  es: {
    label: 'OUR CORE VALUES',
    title: 'What defines us',
    subtitle: 'The principles we build Inled on.',
    values: [
      {
        title: 'No politics, no ideology',
        desc: 'Politics divides people, and computing should never be mixed with ideology.',
      },
      {
        title: 'Friendly community, no elitism',
        desc: 'We are not elitists: we respect and help anyone who wants to contribute.',
      },
      {
        title: 'Everything open-source',
        desc: 'All our projects are e2e auditable, which sets us apart from many projects that claim to be "open-source".',
      },
      {
        title: 'Privacy, P2P and freedom',
        desc: 'Your data is yours: privacy by default, P2P whenever possible and complete freedom over your software.',
      },
      {
        title: 'Sin AI slop',
        desc: 'IA como ayuda, no como fábrica de slop.',
      },
      {
        title: 'The user is our biggest collaborator',
        desc: 'Developer or not: your ideas, bug reports and feedback are what make our projects better.',
      },
    ],
  },
  en: {
    label: 'OUR CORE VALUES',
    title: 'What defines us',
    subtitle: 'The principles we build Inled on.',
    values: [
      {
        title: 'No politics, no ideology',
        desc: 'Politics divides people, and computing should never be mixed with ideology.',
      },
      {
        title: 'Friendly community, no elitism',
        desc: 'We are not elitists: we respect and help anyone who wants to contribute.',
      },
      {
        title: 'Everything open-source',
        desc: 'All our projects are e2e auditable, which sets us apart from many projects that claim to be "open-source".',
      },
      {
        title: 'Privacy, P2P and freedom',
        desc: 'Your data is yours: privacy by default, P2P whenever possible and complete freedom over your software.',
      },
      {
        title: 'No AI slop',
        desc: 'AI as help, not as a slop factory.',
      },
      {
        title: 'The user is our biggest collaborator',
        desc: "Developer or not: your ideas, bug reports and feedback are what make our projects better.",
      },
    ],
  },
}[lang];

---

<section class="values-section">
  <div class="values-container">
    <div class="values-header">
      <div class="values-label">{t.label}</div>
      <h2 class="values-title">{t.title}</h2>
      <p class="values-subtitle">{t.subtitle}</p>
    </div>

    <div class="values-grid">
      {t.values.map((v) => (
        <div class="value-card">
          <h3 class="value-title">{v.title}</h3>
          <p class="value-desc">{v.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .values-section {
    width: 100%;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .values-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  .values-header {
    margin-bottom: 3rem;
  }

  .values-label {
    font-family: var(--sans-font);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.9rem;
  }

  .values-title {
    font-family: var(--sans-font);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin: 0 0 0.9rem 0;
  }

  .values-subtitle {
    font-family: var(--sans-font);
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    color: var(--text-dim);
    line-height: 1.55;
    margin: 0;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .value-card {
    padding: 2rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 22px;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .value-card:hover {
    background: var(--card-hover);
    border-color: var(--border-hover);
  }

  .value-title {
    font-family: var(--sans-font);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.02em;
    margin: 0 0 0.55rem 0;
    line-height: 1.3;
  }

  .value-desc {
    font-family: var(--sans-font);
    font-size: 0.87rem;
    color: var(--text-dim);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 968px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
