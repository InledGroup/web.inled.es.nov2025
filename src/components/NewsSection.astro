---
import { getPosts, formatDate } from '../lib/blogger';
import { getLangFromLocals } from '../i18n/utils';
import { landingUpdates } from '../config/updates';

const lang = getLangFromLocals(Astro.locals);

const posts = await getPosts();
const latestPosts = posts.slice(0, 4);

const updates = landingUpdates.slice(0, 3);
---

<section class="news-section" id="blog">
  <div class="news-container">
    <div class="section-head">
      <p class="section-eyebrow">{lang === 'es' ? 'Novedades' : 'News'}</p>
      <h2 class="section-title">{lang === 'es' ? 'Noticias y actualizaciones' : 'News and updates'}</h2>
      <p class="section-subtitle">
        {lang === 'es'
          ? 'Lo último del blog y de nuestros productos, en un solo lugar.'
          : 'The latest from the blog and our products, all in one place.'}
      </p>
    </div>

    {updates.length > 0 && (
      <div class="news-group">
        <p class="news-group-label">{lang === 'es' ? 'Actualizaciones' : 'Updates'}</p>

        {updates.map((update) => (
          <a href={update.link} class="story" target={update.link.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
            <span class="story-main">
              <span class="story-kicker">{update.tag[lang]}</span>
              <span class="story-title">{update.title[lang]}</span>
              <span class="story-desc">{update.subtitle[lang]}</span>
              <span class="story-link">
                {lang === 'es' ? 'Ver la novedad' : 'See what changed'}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </span>
            <span class="story-side">
              <img
                src={update.image}
                alt=""
                class:list={['story-image', { 'story-image--cover': update.imageFit === 'cover' }]}
                loading="lazy"
              />
              <span class="story-date">{formatDate(update.date)}</span>
            </span>
          </a>
        ))}
      </div>
    )}

    <div class="news-group">
      <p class="news-group-label">{lang === 'es' ? 'Del blog' : 'From the blog'}</p>

      {latestPosts.length > 0 ? latestPosts.map((post) => (
        <a href={`/blog/${post.slug}`} class="story">
          <span class="story-main">
            <span class="story-kicker">
              {post.tags.length > 0 ? post.tags[0] : 'Blog'}
            </span>
            <span class="story-title">{post.title}</span>
            <span class="story-link">
              {lang === 'es' ? 'Leer artículo' : 'Read article'}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </span>
          <span class="story-side">
            <span class="story-thumb">
              {post.thumbnail
                ? <img src={post.thumbnail} alt="" loading="lazy" />
                : <span class="story-thumb-fallback" aria-hidden="true"></span>}
            </span>
            <span class="story-date">{formatDate(post.published)}</span>
          </span>
        </a>
      )) : (
        <p class="news-empty">{lang === 'es' ? 'Pronto habrá nuevas entradas en el blog.' : 'New blog posts coming soon.'}</p>
      )}
    </div>

    <a href="/blog" class="blog-view-all">
      {lang === 'es' ? 'Ver todo el blog' : 'View all posts'}
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</section>

<style>
  .news-section {
    width: 100%;
    background: var(--bg);
    padding: 6rem 1.5rem;
    border-top: 1px solid var(--border);
  }

  .news-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  .section-head {
    max-width: 720px;
    margin-bottom: 2.5rem;
  }

  .section-eyebrow {
    font-family: var(--sans-font);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.9rem;
  }

  .section-title {
    font-family: var(--sans-font);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--text);
    margin: 0 0 0.9rem;
  }

  .section-subtitle {
    font-family: var(--sans-font);
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    line-height: 1.55;
    color: var(--text-dim);
    margin: 0;
  }

  /* ---- Lista de noticias ---- */
  .news-group {
    border-top: 1px solid var(--border);
  }

  .news-group-label {
    font-family: var(--sans-font);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 1.75rem 0 0;
  }

  .story {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
  }

  .story-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    min-width: 0;
    flex: 1;
  }

  .story-kicker {
    font-family: var(--sans-font);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2997ff;
  }

  :global(html[data-theme="light"]) .story-kicker {
    color: #06c;
  }

  .story-title {
    font-family: var(--sans-font);
    font-size: clamp(1.4rem, 2.6vw, 1.95rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.18;
    color: var(--text);
    max-width: 34ch;
  }

  .story-desc {
    font-family: var(--sans-font);
    font-size: clamp(0.95rem, 1.5vw, 1.02rem);
    line-height: 1.55;
    color: var(--text-dim);
    max-width: 54ch;
  }

  .story-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.25rem;
    font-family: var(--sans-font);
    font-size: 0.88rem;
    font-weight: 500;
    color: #2997ff;
  }

  :global(html[data-theme="light"]) .story-link {
    color: #06c;
  }

  .story:hover .story-link {
    text-decoration: underline;
  }

  .story-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .story-image {
    width: 112px;
    height: 112px;
    object-fit: contain;
  }

  .story-image--cover {
    object-fit: cover;
    border-radius: 18px;
    border: 1px solid var(--border);
  }

  .story-thumb {
    display: block;
    width: 208px;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: #0a0a0d;
    border: 1px solid var(--border);
  }

  .story-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .story:hover .story-thumb img {
    transform: scale(1.04);
  }

  .story-thumb-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 30% 20%, rgba(90, 120, 255, 0.25), transparent 60%),
      linear-gradient(135deg, #101018, #05050a);
  }

  .story-date {
    font-family: var(--sans-font);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .news-empty {
    font-family: var(--sans-font);
    font-size: 0.88rem;
    color: var(--text-muted);
    padding: 1.5rem 0;
  }

  .blog-view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 2rem;
    font-family: var(--sans-font);
    font-size: 0.85rem;
    font-weight: 500;
    color: #2997ff;
    text-decoration: none;
  }

  :global(html[data-theme="light"]) .blog-view-all {
    color: #06c;
  }

  .blog-view-all:hover {
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    .news-section {
      padding: 4.5rem 1rem;
    }

    .story {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.9rem 0;
    }

    .story-side {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
    }

    .story-image {
      width: 64px;
      height: 64px;
    }

    .story-image--cover {
      border-radius: 12px;
    }

    .story-thumb {
      width: 132px;
      border-radius: 12px;
    }

    .story-title {
      max-width: none;
    }
  }
</style>
