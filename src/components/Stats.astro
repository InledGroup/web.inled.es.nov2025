---
import { getLangFromLocals } from '../i18n/utils';

const lang = getLangFromLocals(Astro.locals);

const copy = {
  es: {
    downloads: 'Más de 7.000',
    downloadsLabel: 'descargas de nuestro software',
    community: 'Más de 50',
    communityLabel: 'personas en nuestra comunidad',
  },
  en: {
    downloads: 'Over 7,000',
    downloadsLabel: 'downloads of our software',
    community: 'Over 50',
    communityLabel: 'people in our community',
  },
}[lang];
---

<section class="stats" aria-label={lang === 'es' ? 'Cifras de Inled' : 'Inled in numbers'}>
  <div class="stats-inner">
    <div class="stat">
      <span class="stat-value">{copy.downloads}</span>
      <span class="stat-label">{copy.downloadsLabel}</span>
    </div>
    <div class="stat">
      <span class="stat-value">{copy.community}</span>
      <span class="stat-label">{copy.communityLabel}</span>
    </div>
  </div>
</section>

<style>
  .stats {
    width: 100%;
    background: var(--bg);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stats-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.35rem;
  }

  .stat + .stat {
    border-left: 1px solid var(--border);
  }

  .stat-value {
    font-family: var(--sans-font);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--accent);
  }

  .stat-label {
    font-family: var(--sans-font);
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text-dim);
  }

  @media (max-width: 560px) {
    .stats-inner {
      padding: 2rem 1rem;
      gap: 1rem;
    }

    .stat-label {
      font-size: 0.8rem;
    }
  }
</style>
